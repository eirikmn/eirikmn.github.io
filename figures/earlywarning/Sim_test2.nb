Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", "   ", "Non"}]}]}]}]}]}]}], " ", "tipping", " ", 
    "Model", " ", "Constant", " ", "Red", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Noise", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"NTMCRN", "=", 
     RowBox[{"List", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{
       "n", ",", "noise", ",", "phi", ",", "sigma", ",", "no", ",", "phio", 
        ",", "sigmao"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{
       "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
        "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
        ",", "t", ",", "s", ",", "noise", ",", "x2", ",", "ARe", ",", "AR", 
        ",", "noise2", ",", "noisew"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", "650"}], ";", "\[IndentingNewLine]", 
      RowBox[{"noise", " ", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phi", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sigma", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"no", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"phio", " ", "=", " ", "0.1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sigmao", "=", "0.2"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"noise", ",", "no"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"phio", " ", "=", " ", "0.7"}], ";", "\[IndentingNewLine]", 
         RowBox[{"no", " ", "=", " ", 
          RowBox[{
           RowBox[{"phio", "*", "no"}], " ", "+", " ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "sigmao"}], "]"}], "]"}]}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cont", "=", 
       RowBox[{"Interpolation", "[", "noise", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "5"}], "*", 
              RowBox[{"x", "[", "t", "]"}]}], "+", " ", 
             RowBox[{"cont", "[", 
              RowBox[{"t", "+", "1"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"x2", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", "5"}], "*", 
             RowBox[{"x2", "[", "t", "]"}]}]}], " ", ",", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", " ", 
           RowBox[{
            RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "x2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "signal", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"signal", " ", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"signal", ",", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"x", "[", "i", "]"}], "/.", "s"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "650", ",", "1"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"NTMCRN", "=", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"NTMCRN", ",", "signal"}], "]"}]}], ";"}], "\n", ",", "100"}],
