Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", "   ", "Tipping"}]}]}]}]}]}]}], " ", "Model", " ", 
    "with", " ", "white", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Noise", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TMCWN", "=", 
     RowBox[{"List", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{
       "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
        "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
        ",", "t", ",", "s", ",", "noise", ",", "x2"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"n", "=", "1000"}], ";", "\[IndentingNewLine]", 
      RowBox[{"F", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "/", "n"}], ")"}], "*", "t"}], " ", "-", "1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"noise", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0", ",", "0.2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], "^", "3"}]}], "+", 
             RowBox[{"x", "[", "t", "]"}], "-", "F", "+", 
             RowBox[{"noise", "[", "t", "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"x2", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"x2", "[", "t", "]"}], "^", "3"}]}], "+", 
             RowBox[{"x2", "[", "t", "]"}], "-", "F"}]}], " ", ",", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "\[Equal]", "1.25"}], ",", " ", 
           RowBox[{
            RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "1.25"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "x2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], "/.", "s"}], "]"}], ",", " ", 
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"x2", "[", "t", "]"}], "/.", "s"}], "]"}]}], "}"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{"InfiniteLine", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"600", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "}"}]}]}], "]"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "signal", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"signal", " ", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"signal", ",", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"x", "[", "i", "]"}], "/.", "s"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "600", ",", "1"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"TMCWN", "=", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"TMCWN", ",", "signal"}], "]"}]}]}], "\[IndentingNewLine]", 
     ",", "100"}], "]"}]}]}]], "Input",
