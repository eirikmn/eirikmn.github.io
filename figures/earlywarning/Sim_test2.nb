Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TMTDRN", "=", 
     RowBox[{"List", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{
       "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
        "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
        ",", "t", ",", "s", ",", "noise", ",", "x2"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{
       "n", ",", "noise", ",", "phi", ",", "sigma", ",", "no", ",", "phio", 
        ",", "sigmao"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{
       "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
        "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
        ",", "t", ",", "s", ",", "noise", ",", "x2", ",", "ARe", ",", "AR", 
        ",", "noise2", ",", "noisew"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", "300"}], ";", "\[IndentingNewLine]", 
      RowBox[{"F", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "/", "n"}], ")"}], "*", "t"}], " ", "-", "1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"no", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"phio", " ", "=", " ", 
       RowBox[{"aphi", "[", "j", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sigmao", "=", "0.13"}], ";", "\[IndentingNewLine]", 
      RowBox[{"noise", " ", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"noise", ",", "no"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"phio", " ", "=", 
          RowBox[{
           RowBox[{"aphi", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "+", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "*", 
               RowBox[{"bphi", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", "n"}], 
            ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"no", " ", "=", " ", 
          RowBox[{
           RowBox[{"phio", "*", "no"}], " ", "+", " ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "sigmao"}], "]"}], "]"}]}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], ";", "\n", 
      RowBox[{"cont", "=", 
       RowBox[{"Interpolation", "[", "noise", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], "^", "3"}]}], "+", 
             RowBox[{"x", "[", "t", "]"}], "-", "F", "+", 
             RowBox[{"cont", "[", 
              RowBox[{"t", "+", "1"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"x2", "'"}], "[", "t", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"x2", "[", "t", "]"}], "^", "3"}]}], "+", 
             RowBox[{"x2", "[", "t", "]"}], "-", "F"}]}], " ", ",", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "\[Equal]", "1.25"}], ",", " ", 
           RowBox[{
            RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "1.25"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "x2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "signal", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"signal", " ", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"signal", ",", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"x", "[", "i", "]"}], "/.", "s"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "200", ",", "1"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"TMTDRN", "=", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"TMTDRN", ",", "signal"}], "]"}]}], ";"}], "\n", ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "500"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.865065687453308*^9, 3.8650656942829447`*^9}, {
