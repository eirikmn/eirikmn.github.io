       RowBox[{
        RowBox[{"Noise", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "n", ",", "noise", ",", "phi", ",", "sigma", ",", "no", ",", "phio", ",", 
     "sigmao"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
     "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
     ",", "t", ",", "s", ",", "noise", ",", "x2", ",", "ARe", ",", "AR", ",", 
     "noise2", ",", "noisew"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"noise", " ", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"phi", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigma", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"no", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"phio", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmao", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"noise", ",", "no"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"phi", ",", "phio"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"sigma", ",", "sigmao"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"phio", " ", "=", " ", "0.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sigmao", "=", " ", "0.5"}], " ", ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"no", " ", "=", " ", 
       RowBox[{
        RowBox[{"phio", "*", "no"}], " ", "+", " ", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "sigmao"}], "]"}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], 
