Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", "   ", "Tipping"}]}]}]}]}]}]}], " ", "Model", " ", 
    "with", " ", "Constamt", " ", "Red", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Noise", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
     "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
     ",", "t", ",", "s", ",", "noise", ",", "x2"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "n", ",", "noise", ",", "phi", ",", "sigma", ",", "no", ",", "phio", ",", 
     "sigmao"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
     "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
     ",", "t", ",", "s", ",", "noise", ",", "x2", ",", "ARe", ",", "AR", ",", 
     "noise2", ",", "noisew"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "/", "n"}], ")"}], "*", "t"}], " ", "-", "1"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"noise", " ", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"phi", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigma", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"no", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"phio", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmao", "=", "0.08"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"noise", ",", "no"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"phi", ",", "phio"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"sigma", ",", "sigmao"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"phio", " ", "=", " ", "0.9"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"sigmao", "=", " ", "0.15"}], " ", ";"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"no", " ", "=", " ", 
       RowBox[{
        RowBox[{"phio", "*", "no"}], " ", "+", " ", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "sigmao"}], "]"}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", "phi", "]"}], "\[IndentingNewLine]", 
     RowBox[{"ListLinePlot", "[", "sigma", "]"}], "\[IndentingNewLine]", 
     RowBox[{"ListLinePlot", "[", "noise", "]"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cont", "=", 
     RowBox[{"Interpolation", "[", "noise", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"cont", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "1", ",", 
        RowBox[{"n", "+", "1"}]}], "}"}], ",", " ", 
      RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"s", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "^", "3"}]}], "+", 
          RowBox[{"x", "[", "t", "]"}], "-", "F", "+", 
          RowBox[{"cont", "[", 
           RowBox[{"t", "+", "1"}], "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"x2", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"x2", "[", "t", "]"}], "^", "3"}]}], "+", 
          RowBox[{"x2", "[", "t", "]"}], "-", "F"}]}], " ", ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "1"}], ",", " ", 
        RowBox[{
         RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "x2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "n"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
