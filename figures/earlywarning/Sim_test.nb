Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", "   ", "Non"}]}]}]}]}]}]}], "-", 
    RowBox[{"Tipping", " ", "Model", " ", "Constant", " ", "Red", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Noise", " ", "--"}], "--"}], "--"}], "--"}], "--"}]}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "n", ",", "noise", ",", "phi", ",", "sigma", ",", "no", ",", "phio", ",", 
     "sigmao"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "x", ",", "F", ",", "t", ",", "tmax", ",", "zero", ",", "ans", ",", 
     "data", ",", "Trend", ",", "NTrend", ",", "proc", ",", "n", ",", "F", 
     ",", "t", ",", "s", ",", "noise", ",", "x2", ",", "ARe", ",", "AR", ",", 
     "noise2", ",", "noisew"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "300"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"noise", " ", "=", " ", 
    RowBox[{"RandomFunction", "[", 
     RowBox[{
      RowBox[{"ARProcess", "[", 
       RowBox[{
        RowBox[{"{", "0.5", "}"}], ",", "0.2"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "n"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cont", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"noise", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"cont", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "1", ",", "n"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"s", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "5"}], "*", 
           RowBox[{"x", "[", "t", "]"}]}], "+", " ", 
          RowBox[{"cont", "[", 
           RowBox[{"t", "+", "1"}], "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"x2", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{"-", "5"}], "*", 
          RowBox[{"x2", "[", "t", "]"}]}]}], " ", ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"x2", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "x2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "n"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
