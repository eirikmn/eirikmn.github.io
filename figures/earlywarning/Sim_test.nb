    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], "/.", "s"}], "]"}], ",", " ", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"x2", "[", "t", "]"}], "/.", "s"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "n"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
