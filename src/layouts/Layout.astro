---
import "katex/dist/katex.min.css";

const { title = "Test" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    /* =========================
       THEME VARIABLES
    ========================= */

    :root {
      --bg: #ffffff;
      --text: #111111;

      /* layout separators */
      --border: #dddddd;

      /* UI elements (buttons, toggles, chips) */
      --border-ui: #b8b8b8;

      --accent: #1da1f2;
    }

    html.dark {
      --bg: #111111;
      --text: #f5f5f5;

      /* layout separators */
      --border: #333333;

      /* UI elements (brighter for visibility) */
      --border-ui: #8a8a8a;

      --accent: #4da3ff;
    }

    /* =========================
       BASE LAYOUT
    ========================= */

    body {
      margin: 0;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

      background: var(--bg);
      color: var(--text);

      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    main {
      padding: 0;
    }

    .container {
      max-width: 850px;
      margin: 64px auto;
      padding: 0 24px;
    }

    section {
      margin-bottom: 64px;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 16px;
    }

    h2 {
      margin-bottom: 18px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }

    h3 {
      font-size: 1.1rem;
      margin-top: 28px;
      margin-bottom: 10px;
    }

    p {
      line-height: 1.6;
      margin-bottom: 14px;
    }

    ul {
      line-height: 1.6;
      padding-left: 20px;
      margin-bottom: 14px;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      transition: opacity 0.2s ease;
    }

    a:hover {
      opacity: 0.8;
    }
    

    /* =========================
       HEADER
    ========================= */

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 14px 24px;
      border-bottom: 1px solid var(--border);

      backdrop-filter: blur(8px);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .left {
      font-weight: 600;
      font-size: 1.1rem;
      letter-spacing: -0.02em;
      font-variation-settings: "wght" 600;
    }
    .left a {
      color: var(--text);
      text-decoration: none;
   }
   .left a:hover {
      color: var(--accent);
   }
    .right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    nav {
      display: flex;
      gap: 18px;
    }

    nav a {
      color: var(--text);
      opacity: 0.75;
      font-weight: 500;
      transition: opacity 0.2s ease, color 0.2s ease;
    }

    nav a:hover {
      color: var(--accent);
      opacity: 1;
    }

    /* =========================
       THEME TOGGLE
    ========================= */

    .toggle {
      width: 36px;
      height: 36px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 6px;

      border: 1px solid var(--border-ui);
      background: transparent;
      color: var(--text);

      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .toggle:hover {
      background: var(--border);
      border-color: var(--accent);
    }

    /* =========================
       GLOBAL UI ELEMENT FIX
       (IMPORTANT PART)
    ========================= */

    button,
    .github-btn,
    .toggle-btn,
    .software-actions button {
      border: 1px solid var(--border-ui);
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    button:hover,
    .github-btn:hover,
    .toggle-btn:hover,
    .software-actions button:hover {
      border-color: var(--accent);
    }

    /* =========================
       OPTIONAL: BETTER HOVER FEEDBACK
    ========================= */

    button:hover,
    .github-btn:hover,
    .toggle-btn:hover {
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
    }
  </style>
</head>

<body>

  <header>
    <div class="left">
      <a href="/">Eirik Myrvoll-Nilsen</a>
    </div>

    <div class="right">
      <nav>
        <a href="/research">Research</a>
        <a href="/publications">Publications</a>
        <a href="/software">Software</a>
        <a href="/cv">CV</a>
        <a href="/contact">Contact</a>
      </nav>

      <button class="toggle" id="themeToggle" aria-label="Toggle theme">
        🌙
      </button>
    </div>
  </header>

  <main>
    <div class="container">
      <slot />
    </div>
  </main>

  <!-- =========================
       THEME SCRIPT
  ========================= -->
  <script>
    const root = document.documentElement;
    const btn = document.getElementById("themeToggle");

    function updateIcon() {
      btn.textContent = root.classList.contains("dark") ? "☀️" : "🌙";
    }

    function setTheme(mode) {
      root.classList.toggle("dark", mode === "dark");
      localStorage.setItem("theme", mode);
      updateIcon();
    }

    const saved = localStorage.getItem("theme");

    if (saved) {
      setTheme(saved);
    } else {
      const systemDark =
        window.matchMedia("(prefers-color-scheme: dark)").matches;

      setTheme(systemDark ? "dark" : "light");
    }

    btn.addEventListener("click", () => {
      const isDark = root.classList.contains("dark");
      setTheme(isDark ? "light" : "dark");
    });
  </script>

</body>
</html>