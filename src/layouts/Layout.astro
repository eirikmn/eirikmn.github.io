---
import "katex/dist/katex.min.css";
import Footer from "../components/Footer.astro";
import profiles from "../data/profiles.json";
import cv from "../data/cvheader.json";
import education from "../data/education.json";

/* =========================================================
   Props
     title       - page title. Appended with the site name
                   unless `standaloneTitle` is set.
     description - 1-2 sentences. Used for the search result
                   snippet and the link preview.
     image       - social card, relative to the site root.
     noindex     - keep the page out of search results.
========================================================= */

const {
  title = "Eirik Myrvoll-Nilsen",
  description = "Eirik Myrvoll-Nilsen is a postdoctoral research fellow at UiT The Arctic University of Norway, working on Bayesian statistics for climate: long-range dependence, age-depth modeling and early warning signals.",
  image = "/og-image.png",
  standaloneTitle = false,
  noindex = false
} = Astro.props;

const SITE_NAME = "Eirik Myrvoll-Nilsen";
const AUTHOR = "Eirik Myrvoll-Nilsen";

/* Astro.site comes from `site` in astro.config.mjs */
const base = Astro.site ?? new URL("https://eirikmyrvollnilsen.com");

/* Normalise trailing slashes so a page is never indexed
   under two URLs — but keep the one on the root, since
   that is the form the sitemap and the server both use. */
const path = Astro.url.pathname;
const canonical =
  path === "/"
    ? new URL("/", base).href
    : new URL(path.replace(/\/$/, ""), base).href;
const imageURL = new URL(image, base).href;

const fullTitle =
  standaloneTitle || title === SITE_NAME
    ? title
    : `${title} · ${SITE_NAME}`;

/* Structured data. Tells Google that this site and the
   person behind the ORCID / Scholar / GitHub profiles are
   the same entity, which is what connects the site to an
   existing scholarly identity.

   alumniOf comes from education.json rather than being
   retyped, so it stays in step with the CV page. Degrees are
   deduplicated by institution: two degrees from NTNU is one
   alumniOf relationship, not two. */
const alumniOf = [
  ...new Map(
    (education ?? [])
      .filter((e) => e.institution)
      .map((e) => [
        e.institution,
        { "@type": "CollegeOrUniversity", name: e.institution }
      ])
  ).values()
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR,
  url: base.href,
  image: imageURL,
  jobTitle: cv.title,
  email: `mailto:${cv.email}`,

  affiliation: {
    "@type": "CollegeOrUniversity",
    name: cv.affiliation.institution,
    url: cv.affiliation.institutionUrl,
    department: {
      "@type": "Organization",
      name: cv.affiliation.department
    }
  },

  /* worksFor is the employment relationship; affiliation is
     the academic one. Search engines read them differently. */
  worksFor: {
    "@type": "CollegeOrUniversity",
    name: cv.affiliation.institution,
    url: cv.affiliation.institutionUrl
  },

  /* street address, so the site can be placed geographically */
  workLocation: {
    "@type": "Place",
    name: cv.office.building,
    address: {
      "@type": "PostalAddress",
      streetAddress: cv.office.street,
      addressLocality: "Tromsø",
      postalCode: "9019",
      addressCountry: "NO"
    }
  },
  /* where the degrees came from — the relationship a search
     for the name is most likely to be trying to establish */
  ...(alumniOf.length ? { alumniOf } : {}),

  knowsAbout: [
    "Bayesian statistics",
    "Long-range dependence",
    "Age-depth modeling",
    "Early warning signals",
    "Climate science",
    "Integrated nested Laplace approximations"
  ],
  /* same list the footer renders, so the two cannot drift */
  sameAs: profiles.map((p) => p.url)
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={AUTHOR} />
  <link rel="canonical" href={canonical} />

  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- link previews: Slack, Bluesky, LinkedIn, iMessage, ... -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${AUTHOR}, ${SITE_NAME}`} />
  <meta property="og:locale" content="en_GB" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <!-- icons. SVG first for modern browsers; the .ico carries
       hand-snapped 16/32/48 bitmaps for the small sizes and
       for anything that ignores SVG. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

  <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />

  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

  <!-- =========================
       THEME, APPLIED BEFORE FIRST PAINT

       The toggle's own script sits at the end of the body, which
       is too late: the browser paints the light palette first and
       a dark-mode reader gets a white flash on every navigation.

       This runs in <head>, synchronously, before anything is
       drawn. It is deliberately the smallest thing that can
       decide the question — read the stored preference, fall
       back to the OS, set one class — and it must stay in step
       with setTheme() at the end of this file: "dark" and
       "light" are explicit choices, anything else (including a
       missing key, which is how "system" is stored) defers to
       the OS.

       is:inline so Astro leaves it alone; a bundled module would
       be deferred and we would be back to flashing. The
       try/catch is for Safari's private mode, where reading
       localStorage throws — better an unstyled theme than a
       thrown error that stops the rest of the head.
  ========================= -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem("theme");
        var dark =
          stored === "dark" ||
          (stored !== "light" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

        if (dark) document.documentElement.classList.add("dark");
      } catch (e) {
        /* storage unavailable — fall through to the light default */
      }
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    /* =========================
       THEME VARIABLES
    ========================= */

    :root {
      /* Off-white, not white. Pure #ffffff is a hard surface to
         read a long page against, and the warmth matters as much
         as the value: it keeps the page distinguishable from the
         neutral white the figures are plotted on, so a figure can
         sit on a true-white plate and lift off the page instead
         of dissolving into it.

         How far this can go is set by the link colour, not by
         taste. Content links and citations both resolve to
         color-mix(--accent 70%, --text) = #1976ae, which is
         4.95:1 on white — only 0.45 above the AA floor. It reads
         4.70:1 here and falls below 4.5 at about #f2f2f2, which
         is the real limit.

         Everything derived from --bg follows on its own:
         --text-muted below, the card tint on the software and
         contact panels, the header's translucent bar, and the
         CV's toggle pill. */
      --bg: #faf9f7;
      --text: #111111;

      /* layout separators */
      --border: #dddddd;

      /* UI elements (buttons, toggles, chips) */
      --border-ui: #b8b8b8;

      --accent: #1da1f2;

      /* tells the browser to paint its own furniture — scroll
         bars, the caret, form controls — to match. Without it a
         dark page keeps light scrollbars. */
      color-scheme: light;

      /* ---------------------------------------------------
         SURFACE AND ELEVATION

         A card used to be color-mix(--bg 92%, --accent) in
         both themes, and that one formula does opposite
         things. On the dark page it lands LIGHTER than its
         background — a surface catching light. On the light
         page it lands DARKER — which the eye reads as a stain
         or a recess rather than a panel. Same code, and it is
         most of why the light theme looked flat beside the
         dark one.

         So the surface is a token, set per theme to whatever
         lifts: white here, the accent tint below.

         Depth then has to come from somewhere, and the two
         themes cannot use the same cue. On near-black a
         shadow is invisible, which is why the dark theme is
         right to carry its depth in borders alone. On a light
         page shadow is the native cue, and its absence is
         what makes a border-only design read as a wireframe.
         Hence a real shadow here and none in dark mode.

         Warm, not grey: the page is #faf9f7, and neutral grey
         shade over a warm ground reads as dirt. #3a3128 is a
         warm dark, so the shadow reads as shade.
      --------------------------------------------------- */
      --surface: #ffffff;

      --shadow:
        0 1px 2px color-mix(in srgb, #3a3128 8%, transparent),
        0 2px 10px color-mix(in srgb, #3a3128 6%, transparent);

      --shadow-hover:
        0 2px 4px color-mix(in srgb, #3a3128 9%, transparent),
        0 8px 22px color-mix(in srgb, #3a3128 9%, transparent);
    }

    html.dark {
      --bg: #111111;
      --text: #f5f5f5;

      /* layout separators */
      --border: #333333;

      /* UI elements (brighter for visibility) */
      --border-ui: #8a8a8a;

      --accent: #4da3ff;

      color-scheme: dark;

      /* The tint that was the card colour in both themes.
         Here it is correct on its own terms: mixed into a
         near-black page it comes out LIGHTER than the page,
         so the card lifts without needing a shadow — which
         is just as well, since a shadow on #111111 is
         invisible. Depth stays in the borders. */
      --surface: color-mix(in srgb, var(--bg) 92%, var(--accent));

      --shadow: none;
      --shadow-hover: none;
    }

    /* Secondary text: dates, affiliations, captions, nav.
       Declared once — custom properties resolve at use
       time, so this re-derives itself from whichever
       palette is active rather than needing a duplicate
       in the html.dark block above.

       65% keeps it clear of the 4.5:1 contrast floor in
       both themes: roughly 5.9:1 on white, 7.8:1 on the
       dark background. */
    :root {
      --text-muted: color-mix(in srgb, var(--text) 65%, var(--bg));
    }

    /* Dragging over text gave the browser's default blue, which
       on a page with its own accent reads as a leak from outside
       the design. 22% keeps the text underneath legible in both
       themes rather than reversing it out. */
    :global(::selection) {
      background: color-mix(in srgb, var(--accent) 22%, transparent);
    }

    /* =========================
       BASE LAYOUT
    ========================= */

    body {
      margin: 0;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

      background: var(--bg);
      color: var(--text);

      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    main {
      padding: 0;
    }

    /* =========================
       FOCUS

       One ring for every interactive element. :focus-visible
       rather than :focus, so it appears for keyboard and
       assistive-tech users without flashing on mouse clicks.
    ========================= */

    /* :global() because this block is scoped — without it the
       rule would only reach the header and skip link, not the
       links and buttons inside each page. */
    :global(:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 2px;
    }

    /* =========================
       SKIP LINK

       Without this, reaching the content by keyboard means
       tabbing past the brand, five nav links and the theme
       toggle on every single page.
    ========================= */

    .skip-link {
      position: absolute;
      left: 8px;
      top: -100px;
      z-index: 2000;

      padding: 10px 16px;
      border-radius: 8px;

      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--accent);
      text-decoration: none;

      transition: top 0.15s ease;
    }

    .skip-link:focus {
      top: 8px;
    }

    /* =========================
       REDUCED MOTION

       Honour the OS-level setting. Transitions and transforms
       collapse to effectively instant rather than being
       removed, so state changes still register.
    ========================= */

    @media (prefers-reduced-motion: reduce) {
      :global(*),
      :global(*::before),
      :global(*::after) {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }

      /* the lift on the research cards is motion for its own
         sake; SectionNav no longer nudges on hover at all */
      :global(.themes li:hover),
      :global(.themes li:hover a::after) {
        transform: none !important;
      }
    }

    .container {
      max-width: 850px;
      margin: 64px auto;
      padding: 0 24px;
    }

    /* A `section { margin-bottom: 64px }` rule used to sit here.
       It was one of the dead ones, so its 64px had never been
       tested against anything — and once the rules went global
       it would have landed on far more than the homepage
       wrapper it was written for: every .cv-section card (28px
       apart today) and every .pub-year-group (32px). Both would
       have jumped to 64. Removed rather than globalised; the
       pages that want section spacing already set their own. */

    /* :global() throughout the typographic rules below.

       Astro scopes a bare `h2 { }` to `h2:where(.astro-xxxx)`
       and only puts that class on elements in THIS component's
       template — which holds a header, a main and a footer, and
       no headings or paragraphs at all. Every one of these rules
       was therefore matching nothing, and had been since they
       were written. It went unnoticed because the intended
       values sit very close to the browser defaults they were
       silently falling back to: 1.45rem against a UA 1.5em for
       h2, 2rem against 2em for h1. What did NOT survive the
       fallback was everything with no default — the letter
       spacing, the 48px heading margins, the h2 rule, and the
       1.6 line height on body copy.

       Verified with @astrojs/compiler: `h2 {}` emits
       `h2:where(.astro-xxxx){}`, `:global(h2) {}` emits `h2{}`.
    ========================= */

    /* =========================
       HEADINGS

       An explicit scale: 2 / 1.45 / 1.15 rem against a 1rem
       body. h2 previously had no font-size at all and fell
       back to the browser's 1.5em, and h3 at 1.1rem was only
       10% larger than body text — not enough to register as
       a heading.

       Every heading gets noticeably more space above than
       below, so it binds to the section it introduces rather
       than floating between two paragraphs.
    ========================= */

    /* 600, explicitly, on all three heading levels.

       Nothing set a heading weight, so they fell to the user
       agent's `bold` — 700 — and the Google Fonts request above
       loads 400, 500 and 600 only. The browser was therefore
       SYNTHESISING every heading on the site: smearing the 400
       face rather than drawing a real cut. Faux bold is muddier
       at large sizes, which is exactly where the headings live.

       600 rather than adding 700 to the request: it is already
       loaded, so this costs no extra download, and it is the
       weight the wordmark in the header uses — so headings and
       the site's own name are now cut from the same cloth. */
    :global(h1),
    :global(h2),
    :global(h3) {
      font-weight: 600;
    }

    :global(h1) {
      font-size: 2rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin-top: 0;
      margin-bottom: 16px;
    }

    :global(h2) {
      font-size: 1.45rem;
      line-height: 1.25;
      letter-spacing: -0.01em;

      margin-top: 48px;
      margin-bottom: 16px;
    }

    /* A short tick rather than a full-width rule.

       The rule was the third kind of horizontal line on a page
       that now also has bordered cards and shadows under them,
       and full-width rules chop the column into slabs. A 2.5rem
       mark separates just as well without banding.

       The colour is the one already used for the summary bullets
       and the label before a cite-panel note, so this reads as
       the same quiet-marker idiom rather than a fourth thing. It
       also gives light mode a little accent presence, which it
       otherwise only gets from links. */
    :global(h2::after) {
      content: "";
      display: block;

      width: 2.5rem;
      height: 2px;
      margin-top: 8px;

      border-radius: 1px;
      background: color-mix(in srgb, var(--accent) 60%, var(--border-ui));
    }

    :global(h3) {
      font-size: 1.15rem;
      line-height: 1.3;

      margin-top: 32px;
      margin-bottom: 8px;
    }

    /* no leading gap when a heading opens a section */
    :global(h2:first-child),
    :global(h3:first-child) {
      margin-top: 0;
    }

    :global(p) {
      line-height: 1.6;
      margin-bottom: 14px;
    }

    :global(ul) {
      line-height: 1.6;
      padding-left: 20px;
      margin-bottom: 14px;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      transition: opacity 0.2s ease;
    }

    a:hover {
      opacity: 0.8;
    }
    /* Content links carry colour at rest, not only on hover.

       They used to be `color: var(--text)` with a 0.5px underline at 35%
       opacity - the same colour as the surrounding prose, distinguished
       by a hairline most readers will not register. Colour is the cue
       people actually scan for, and hover is no help at all on a touch
       screen, where there is no hover state to discover.

       One formula for both themes, mixing the accent toward --text.
       Because --text flips with the theme, so does the direction of the
       mix: in light mode it darkens the accent to #1976ae, and in dark
       mode it pales it to #7fbcfc. Both read as "link", neither shouts.

       70% is the ceiling in light mode, not a preference: it is the
       strongest blue that still clears WCAG AA on white at 4.95:1, where
       75% drops to 4.48:1 and the raw accent is 2.83:1. Dark mode is
       comfortable at 9.42:1.

       Hover then moves to the accent at full strength in both themes,
       which is a deltaE of about 20 in light and 18 in dark - plainly
       visible either way. An earlier version set dark mode to the full
       accent at rest, which left hover with nowhere to go: same colour
       before and after, so only the underline moved.

       The underline stays, at full width rather than a hairline. Colour
       alone is not a sufficient signal: it fails for readers with colour
       vision deficiency, and WCAG 1.4.1 asks for a second cue. */
    :global(.container a:not([class])),
    :global(.link) {
      color: color-mix(in srgb, var(--accent) 70%, var(--text));
      text-decoration: none;
      font-weight: 500;

      border-bottom: 1px solid color-mix(in srgb, currentColor 40%, transparent);
      transition: color 0.15s ease, border-color 0.15s ease;

      overflow-wrap: anywhere;
    }

    :global(.container a:not([class]):hover),
    :global(.link:hover) {
      color: var(--accent);
      border-bottom-color: currentColor;
      opacity: 1;
    }
    

    /* =========================
       HEADER
    ========================= */

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;

      /* The bar itself stays full-bleed, so the border and the
         blurred background still span the window. Its contents
         are pulled in to line up with the 850px text column
         below: .container is content-box, so its text starts at
         (100% - 850px) / 2 from each edge.

         max() keeps the plain 24px gutter once the viewport is
         narrower than the column, which makes this a no-op on
         anything below roughly 900px. */
      padding: 14px max(24px, calc((100% - 850px) / 2));

      border-bottom: 1px solid var(--border);

      backdrop-filter: blur(8px);

      /* Elevation once the page has moved under it. At rest the
         header is part of the page and the border is enough; the
         moment content slides beneath it, it is floating, and a
         border alone does not say so on a light background. The
         shadow token is `none` in dark mode, so this is a
         light-mode cue only — which is correct, because on a
         near-black page the blur and the border already read as
         a layer. */
      box-shadow: none;
      transition: box-shadow 0.2s ease;
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    /* =========================
       WORDMARK

       Two weights rather than one. At a uniform 600 the name
       read as a bolded nav link; splitting it makes it a mark,
       and puts the weight on the surname — the half that gets
       cited, searched and remembered.

       400 and 600 because those are what the Google Fonts URL
       above actually requests. Inter is loaded as static
       instances rather than the variable font, so a 700 here
       would be synthesised by the browser, and the
       font-variation-settings declaration that used to sit on
       this rule did nothing whatsoever.
    ========================= */
    header[data-scrolled="true"] {
      box-shadow: var(--shadow);
    }

    .left {
      font-size: 1.1rem;
      letter-spacing: -0.02em;
    }

    .left .given {
      font-weight: 400;
    }

    .left .family {
      font-weight: 600;

      /* A hyphen is a break opportunity, so a narrow enough
         header would set "Myrvoll-" above "Nilsen". Only the
         surname is locked: the space before it stays breakable,
         so this can never force a horizontal overflow. In
         practice the whole name holds one line anyway — even at
         320px the brand has roughly 240px and needs about 150. */
      white-space: nowrap;
    }

    .left a {
      color: var(--text);
      text-decoration: none;
   }
   .left a:hover {
      color: var(--accent);
   }
    .right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    nav {
      display: flex;
      gap: 18px;
    }

    nav a {
      color: var(--text);
      opacity: 0.75;
      font-weight: 500;
      transition: opacity 0.2s ease, color 0.2s ease;
    }

    nav a:hover {
      color: var(--accent);
      opacity: 1;
    }

    /* =========================
       THEME TOGGLE
    ========================= */

    .toggle {
      width: 36px;
      height: 36px;

      display: flex;
      align-items: center;
      justify-content: center;

      /* was 6px — the only 6px radius on a site whose other
         controls are 999px pills and whose cards are 12px */
      border-radius: 999px;

      border: 1px solid var(--border-ui);
      background: transparent;
      color: var(--text);

      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease,
                  color 0.2s ease;
    }

    /* the same wash every other control on the site uses, rather
       than filling with --border, which is a layout token and
       came out heavier than the pill buttons beside it */
    .toggle:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
    }

    .toggle-icon {
      width: 17px;
      height: 17px;
      display: block;
    }

    /* Three states now, so the icon shows the CURRENT mode
       rather than the destination. With two states "click me to
       get a moon" was readable; with three, an icon promising the
       next state in a cycle of three is a puzzle. The accessible
       name carries the destination instead, where it can say it
       in words.

       Driven by a data attribute the script sets rather than the
       theme class on <html>: both halves of the selector are then
       inside this component, which is what Astro's scoping sees. */
    .toggle .toggle-icon {
      display: none;
    }

    .toggle[data-mode="system"] .icon-system,
    .toggle[data-mode="light"] .icon-sun,
    .toggle[data-mode="dark"] .icon-moon {
      display: block;
    }

    /* =========================
       GLOBAL UI ELEMENT FIX
       (IMPORTANT PART)
    ========================= */

    button,
    .github-btn,
    .toggle-btn,
    .software-actions button {
      border: 1px solid var(--border-ui);
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    button:hover,
    .github-btn:hover,
    .toggle-btn:hover,
    .software-actions button:hover {
      border-color: var(--accent);
    }

    /* =========================
       OPTIONAL: BETTER HOVER FEEDBACK
    ========================= */

    button:hover,
    .github-btn:hover,
    .toggle-btn:hover {
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
    }

    @media (max-width: 600px) {
    body {
      font-size: 1rem;
    }
    .container {
      width: 100%;
      margin: 32px auto;
      padding: 0 18px;
      box-sizing: border-box;
    }
    header {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "brand toggle"
      "nav   nav";
    row-gap: 10px;
    align-items: center;
    padding: 10px 18px;
  }

  .left {
    grid-area: brand;
    font-size: 1rem;
  }

  /* dissolve the wrapper so nav and toggle can sit on different rows */
  .right {
    display: contents;
  }

  nav {
    grid-area: nav;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 12px;
    font-size: 0.85rem;
  }

  .toggle {
    grid-area: toggle;
    width: 32px;
    height: 32px;
    justify-self: end;
  }
  :global(.cv-section) { scroll-margin-top: 90px; }
  }
  </style>
</head>

<body>

  <a class="skip-link" href="#main-content">Skip to content</a>

  <header>
    <div class="left">
      <a href="/"><span class="given">Eirik</span> <span class="family">Myrvoll-Nilsen</span></a>
    </div>

    <div class="right">
      <nav>
        <a href="/research">Research</a>
        <a href="/publications">Publications</a>
        <a href="/software">Software</a>
        <a href="/cv">CV</a>
        <a href="/contact">Contact</a>
      </nav>

      {/* Inline SVG rather than an emoji. 🌙 / ☀️ rendered as
          whichever glyph the reader's platform ships — a different
          shape and a different palette on Apple, Android and
          Windows — and being full-colour it was the only saturated
          non-accent thing in the header. Painted with currentColor
          it takes the button's own colour instead, which means it
          follows the theme and picks up the accent on hover, the
          same mechanism ProfileIcons uses for its masked icons. */}
      <button
        class="toggle"
        id="themeToggle"
        data-mode="system"
        aria-label="Theme: system. Switch to light."
      >
        <svg class="toggle-icon icon-system" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2.6" y="4" width="18.8" height="12.4" rx="2"
                fill="none" stroke="currentColor" stroke-width="1.9" />
          <line x1="8.6" y1="20" x2="15.4" y2="20"
                stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
          <line x1="12" y1="16.4" x2="12" y2="20"
                stroke="currentColor" stroke-width="1.9" />
        </svg>
        <svg class="toggle-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7z"
          />
        </svg>
        <svg class="toggle-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
            <line x1="12" y1="2.4" x2="12" y2="4.9" />
            <line x1="12" y1="19.1" x2="12" y2="21.6" />
            <line x1="2.4" y1="12" x2="4.9" y2="12" />
            <line x1="19.1" y1="12" x2="21.6" y2="12" />
            <line x1="5.3" y1="5.3" x2="7.1" y2="7.1" />
            <line x1="16.9" y1="16.9" x2="18.7" y2="18.7" />
            <line x1="5.3" y1="18.7" x2="7.1" y2="16.9" />
            <line x1="16.9" y1="7.1" x2="18.7" y2="5.3" />
          </g>
        </svg>
      </button>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <div class="container">
      <slot />
    </div>
