  <Footer />

  <!-- =========================
       THEME SCRIPT
  ========================= -->
  <script>
    const root = document.documentElement;
    const btn = document.getElementById("themeToggle");

    /* Three modes, cycled in this order. "system" is first
       because it is the default: a visitor who has never touched
       the button is following their OS, and the button should say
       so rather than claiming a choice they never made. */
    const ORDER = ["system", "light", "dark"];

    const media = window.matchMedia("(prefers-color-scheme: dark)");

    let mode = localStorage.getItem("theme");
    if (!ORDER.includes(mode)) mode = "system";

    function nextOf(current) {
      return ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
    }

    function apply() {
      const dark = mode === "dark" || (mode === "system" && media.matches);
      root.classList.toggle("dark", dark);

      /* CSS picks the icon off data-mode; the label has to move
         with it, or a screen reader announces the wrong
         destination. It names the current mode as well as the
         next, since the icon alone cannot say which of three. */
      btn.dataset.mode = mode;
      btn.setAttribute(
        "aria-label",
        `Theme: ${mode}. Switch to ${nextOf(mode)}.`
      );
    }

    function setTheme(next) {
      mode = next;

      /* "system" is the absence of a preference, so it is stored
         as the absence of a key. A reader who cycles back to it
         is returned to the default rather than pinned to whatever
         their OS happened to be at the time. */
      if (mode === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", mode);

      apply();
    }

    /* follow the OS live while in system mode — someone on a
       sunset schedule should not have to reload */
    media.addEventListener("change", () => {
      if (mode === "system") apply();
    });

    btn.addEventListener("click", () => setTheme(nextOf(mode)));

    apply();

    /* ---------------------------------------------------------
       HEADER ELEVATION

       An observer on a zero-height sentinel at the very top of
       the document, rather than a scroll listener: the browser
       tells us when the top of the page leaves the viewport, so
       there is no handler running on every frame of every
       scroll. Cheap enough to leave on.
    --------------------------------------------------------- */
    const header = document.querySelector("header");

    if (header && "IntersectionObserver" in window) {
      const sentinel = document.createElement("div");
      sentinel.setAttribute("aria-hidden", "true");
      sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
      document.body.prepend(sentinel);

      new IntersectionObserver(
        ([entry]) => {
          header.dataset.scrolled = String(!entry.isIntersecting);
        },
        { threshold: 0 }
      ).observe(sentinel);
    }
  </script>

</body>
