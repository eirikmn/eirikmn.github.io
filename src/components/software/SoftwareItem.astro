---
import { resolveCitations } from "../../lib/citable.js";
import { createCitations } from "../../lib/references.js";
import "../../styles/citations.css";

const {
  name,
  tagline,
  summary = [],
  details,
  install,
  demo,
  cite,
  github,
  language,
  research
} = Astro.props;

const idBase = name.replace(/\s+/g, "-").toLowerCase();

const panels = {
  details: `${idBase}-details`,
  install: `${idBase}-install`,
  demo: `${idBase}-demo`,
  cite: `${idBase}-cite`
};

const detailsArray = Array.isArray(details)
  ? details
  : typeof details === "string"
    ? details.split("\n\n")
    : [];

const dependencyInstallCmd =
  install?.dependencies?.length > 0
    ? `install.packages(c(${install.dependencies.map(d => `"${d}"`).join(", ")}))`
    : null;

const formatCode = (input) => {
  if (!input) return null;
  if (typeof input === "string") return input;
  if (Array.isArray(input)) return input.join("\n");
  if (typeof input === "object" && Array.isArray(input.code)) {
    return input.code.join("\n");
  }
  return null;
};

/* =========================================================
   CITATIONS

   Resolved from papers.bib and references.bib by key, rather
   than stored as hand-written HTML in software.json. Two
   things follow from that: the references render through the
   same formatter the research pages use, so they match by
   construction; and each one has a real BibTeX record behind
   it, where the old `bibtex` field was the literal placeholder
   "@article{...}".
========================================================= */
const primaryCitations = resolveCitations(cite?.keys, `${name} cite.keys`);
const secondaryCitations = resolveCitations(cite?.more_keys, `${name} cite.more_keys`);

/* =========================================================
   CITATIONS IN THE DETAILS PANEL

   The Details prose is where the package is actually argued
   for, so it cites the literature — and it used to do so in
   hand-written plain text, "(Rue et al., 2009)", followed by
   a hand-maintained "References:" list of bare paragraphs.
   That was the one place on the site not running through
   src/lib/references.js, and it showed: the citations were
   inert rather than linked, the list had no hanging indent
   and no DOIs, "&" stood where the rest of the site writes
   "and", page ranges kept their hyphens, and the two halves
   had already drifted — the INLA.climate text cited Huybers
   and Curry as 2005 while its own list said 2006.

   Same machinery as the research pages now: [[key]] markers
   in software.json, expanded here, and a list DERIVED from
   what each package's text cites.

   One recorder per package, not one per page. Three packages
   share /software, and each needs a list of its own — a
   shared recorder would give all three the union of what any
   of them cited. The anchor is namespaced for the same
   reason: rue2009 is cited by all three, and a fixed
   "ref-rue2009" would be a duplicate id whose links all
   landed in the first package's panel.
========================================================= */
const detailCitations = createCitations({
  sources: [
    { path: "./src/data/references.bib", anchor: `ref-${idBase}` },
    { path: "./src/data/papers.bib", anchor: `ref-${idBase}` }
  ]
});

/* expanded before bibliography() is read — that expansion is
   what records which works this package cited */
const detailsHtml = detailsArray.map((p) => detailCitations.expandCitations(p));
const detailsReferences = detailCitations.bibliography();

const linkify = (text) => {
  if (!text) return text;
  const urlRegex = /(https?:\/\/[^\s]+)/g;
  return text.replace(urlRegex, (url) =>
    `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`
  );
};
---

<div class="software-item">

  <!-- HEADER -->
  <div class="software-header">
    <div>
      {/* language sits with the name: it is an attribute of
          the package, and putting it here makes it scannable
          when comparing several. A badge, not a button —
          nothing here is clickable. */}
      <div class="software-title">
        <strong>{name}</strong>
        {language && <span class="badge language">{language}</span>}
      </div>

      {tagline && <div class="software-tagline">{tagline}</div>}
    </div>
  </div>

  <!-- SUMMARY -->
  {summary?.length > 0 && (
    <ul class="software-summary">
      {summary.map((s) => <li>{s}</li>)}
    </ul>
  )}

  {/* Below the summary, not between it and the tagline.

      The tagline states the claim and the bullets elaborate
      it — one thought in two parts — and this link used to
      run straight through the middle of it. Being the only
      accent-coloured thing up there, it was also the
      brightest element on the card, sitting in precisely the
      seam where the eye should not stop.

      Still its own line rather than folded into the button
      row: the original reason for keeping it out of that row
      holds, since the row is already full at five on a
      phone. */}
  {research && (
    <a class="research-link" href={research.href}>
      <span class="research-label">Research:</span>
      {research.label}
    </a>
  )}

  <!-- ACTIONS -->
  <div class="software-actions">

    <button data-toggle={panels.details} aria-expanded="false" aria-controls={panels.details}>ℹ Details</button>
    <button data-toggle={panels.install} aria-expanded="false" aria-controls={panels.install}>⬇ Install</button>
    <button data-toggle={panels.demo} aria-expanded="false" aria-controls={panels.demo}>
      <span class="play-icon" aria-hidden="true">
        <svg viewBox="0 0 10 10" focusable="false">
          <path d="M3 1.5 L7 5 L3 8.5 Z" fill="currentColor" />
        </svg>
      </span>
      Demo
    </button>

    <button data-toggle={panels.cite} aria-expanded="false" aria-controls={panels.cite}>📚 Cite</button>

    {github && (
      <a class="github-btn" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .5C5.7.5.7 5.7.7 12.1c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.4-3.9-1.4-.5-1.2-1.2-1.5-1.2-1.5-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1.8 2.2 3.2 1.6.1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-6 0-1.3.5-2.3 1.1-3.1-.1-.3-.5-1.4.1-3 0 0 .9-.3 3 1.1.9-.2 1.9-.3 2.9-.3s2 .1 2.9.3c2.1-1.4 3-1.1 3-1.1.6 1.6.2 2.7.1 3 .7.8 1.1 1.8 1.1 3.1 0 4.7-2.7 5.7-5.3 6 .4.4.8 1.1.8 2.3v3.4c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.3 5.7 18.3.5 12 .5z"
          />
        </svg>
        <span>GitHub</span>
      </a>
    )}

  </div>

  <!-- DETAILS -->
  <div id={panels.details} class="panel">

    {detailsHtml.map((p) => (
      <p set:html={p}></p>
    ))}

    {detailsReferences && (
      <>
        <div class="panel-title">References</div>
        <div class="details-refs" set:html={detailsReferences}></div>
      </>
    )}

  </div>

  <!-- INSTALL -->
  <div id={panels.install} class="panel">

    {install?.note && (
      <>
        <div class="panel-title">Before installing</div>
        <ul>
          {install.note.map((n) => (
            <li set:html={linkify(n)}></li>
          ))}
        </ul>
      </>
    )}

    {formatCode(install?.r) && (
      <>
        <div class="panel-title">Install</div>
        <div class="code-wrapper">
          <button class="copy-btn">Copy</button>
          <pre class="code"><code>{formatCode(install.r)}</code></pre>
        </div>
      </>
    )}

  </div>

  <!-- DEMO -->
  <div id={panels.demo} class="panel">

    {demo?.code && (
      <>
        <div class="panel-title">R code</div>
        <div class="code-wrapper">
          <button class="copy-btn">Copy</button>
          <pre class="code"><code>{demo.code.join("\n")}</code></pre>
        </div>
      </>
    )}

    {demo?.output && (
      <>
        <div class="panel-title">Output</div>
        <div class="code-wrapper">
          <button class="copy-btn">Copy</button>
          <pre class="code"><code>{demo.output.join("\n")}</code></pre>
        </div>
      </>
    )}


{/* ADD THIS */}
{demo?.plots?.length > 0 && (
  <>
    <div class="panel-title">Plots</div>
    <div class="demo-plots">
      {demo.plots.map((p) => (
        <img src={p} alt="Demo plot" />
      ))}
    </div>
  </>
)}

  </div>
<!-- CITE -->
<div id={panels.cite} class="panel">

  {cite?.text && (
    <div class="cite-text">
      <p set:html={cite.text}></p>
    </div>
  )}

  

  {primaryCitations.length > 0 && (
    <ul class="reflist cite-list">
      {primaryCitations.map((c) => (
        <li>
          {c.note && <span class="cite-note">{c.note}</span>}
          <span set:html={c.html}></span>
          <button
            class="cite-copy"
            data-bibtex={`${idBase}-${c.key}`}
            data-state="idle"
            title="Copy BibTeX"
          >
            {/* An icon is the part a reader recognises without
                reading: a label alone can be a tag, a label with
                a copy glyph is a control. Swaps to a tick on
                success, so the confirmation is not carried by
                the word "Copied" alone. */}
            <svg class="cite-icon icon-copy" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 9h10v10H9z M5 15V5h10"
              />
            </svg>
            <svg class="cite-icon icon-check" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12.5l4.5 4.5L19 7"
              />
            </svg>
            <span class="cite-label">
              <span aria-hidden="true">BibTeX</span>
              <span aria-hidden="true">Copied</span>
              <span aria-hidden="true">Failed</span>
            </span>
            <span class="cite-live" aria-live="polite"></span>
          </button>
          <pre hidden data-bib={`${idBase}-${c.key}`}>{c.bibtex}</pre>
        </li>
      ))}
    </ul>
  )}

  {cite?.more_text && (
    <div class="cite-text">
      <p set:html={cite.more_text}></p>
    </div>
  )}

  {secondaryCitations.length > 0 && (
    <ul class="reflist cite-list">
      {secondaryCitations.map((c) => (
        <li>
          {c.note && <span class="cite-note">{c.note}</span>}
          <span set:html={c.html}></span>
          <button
            class="cite-copy"
            data-bibtex={`${idBase}-${c.key}`}
            data-state="idle"
            title="Copy BibTeX"
          >
            {/* An icon is the part a reader recognises without
                reading: a label alone can be a tag, a label with
                a copy glyph is a control. Swaps to a tick on
                success, so the confirmation is not carried by
                the word "Copied" alone. */}
            <svg class="cite-icon icon-copy" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 9h10v10H9z M5 15V5h10"
              />
            </svg>
            <svg class="cite-icon icon-check" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12.5l4.5 4.5L19 7"
              />
            </svg>
            <span class="cite-label">
              <span aria-hidden="true">BibTeX</span>
              <span aria-hidden="true">Copied</span>
              <span aria-hidden="true">Failed</span>
            </span>
            <span class="cite-live" aria-live="polite"></span>
          </button>
          <pre hidden data-bib={`${idBase}-${c.key}`}>{c.bibtex}</pre>
        </li>
      ))}
    </ul>
  )}

 
</div>

</div>


<script>
document.addEventListener("click", (e) => {
  const btn = e.target.closest("[data-toggle]");

  if (btn) {
    const el = document.getElementById(btn.dataset.toggle);
    if (!el) return;

    const allPanels = document.querySelectorAll(".panel");
    const allButtons = document.querySelectorAll(".software-actions [data-toggle]");

    const isOpening = !el.classList.contains("open");

    // close everything
    allPanels.forEach(p => p.classList.remove("open"));
    allButtons.forEach(b => {
      b.classList.remove("active");
      /* the panels are mutually exclusive, so closing the others has to
         reset their announced state too, not just their appearance */
      b.setAttribute("aria-expanded", "false");
    });

    // toggle selected one
    if (isOpening) {
      el.classList.add("open");
      btn.classList.add("active");
      btn.setAttribute("aria-expanded", "true");
    }

    return;
  }

  /* Per-citation BibTeX copy. Same mechanism as the publication pages:
     read the hidden [data-bib] block, swap a data-attribute rather than
     the label so the button cannot resize, and report failure instead of
     claiming success when the clipboard refuses. */
  const citeCopy = e.target.closest(".cite-copy");
  if (citeCopy) {
    const bib = document.querySelector(
      `[data-bib="${citeCopy.getAttribute("data-bibtex")}"]`
    );
    if (!bib) return;

    const live = citeCopy.querySelector("[aria-live]");
    const done = (state, message) => {
      citeCopy.dataset.state = state;
      if (live) live.textContent = message;
      clearTimeout(citeCopy._resetTimer);
      citeCopy._resetTimer = setTimeout(() => {
        citeCopy.dataset.state = "idle";
        if (live) live.textContent = "";
      }, 1500);
    };

    navigator.clipboard?.writeText(bib.textContent).then(
      () => done("copied", "BibTeX copied to clipboard"),
      () => done("failed", "Copy failed. Select the citation manually.")
    ) ?? done("failed", "Copy failed. Select the citation manually.");

    return;
  }

  const copyBtn = e.target.closest(".copy-btn");
  if (copyBtn) {
    const wrapper = copyBtn.closest(".code-wrapper");
    const codeEl = wrapper.querySelector("code");

    navigator.clipboard.writeText(codeEl.innerText);

    copyBtn.textContent = "Copied!";
    setTimeout(() => copyBtn.textContent = "Copy", 1200);
  }
});
</script>

<style>
/* =========================
   THEME VARIABLES
   ========================= */

/* Only the code-block palette belongs here. This block used
   to also redefine --text, --border-ui and --accent with
   values that differed from Layout.astro, which meant the
   Software page was quietly running a second colour scheme
   (accent #2563eb rather than the site's #1da1f2). Removed
   so the tokens resolve to the site palette. */

:root {
  /* Warmed to sit on the off-white page, and darkened to keep
     the step it used to have. #f3f4f6 stood 1.10 clear of a
     #ffffff page but only 1.05 clear of this one, which left the
     border doing all the work of saying "this is a code block".
     #efeee9 restores the original 1.10. */
  --code-bg: #efeee9;
  --code-text: #111827;
  --code-border: #e5e3dc;
}

html.dark {
  --code-bg: #1f2937;
  --code-text: #e5e7eb;
  --code-border: #374151;
}

/* fallback */
[data-theme="dark"] {
  --code-bg: #1f2937;
  --code-text: #e5e7eb;
  --code-border: #374151;
}

/* ========================= */

/* same panel treatment as .contact-card on the Contact page:
   a uniform border, 12px radius, and the page background
   nudged towards the accent so the tint follows the theme */
.software-item {
  padding: 1.5rem;

  border: 1px solid var(--border);
  border-radius: 12px;

  background: color-mix(in srgb, var(--bg) 92%, var(--accent));

  display: flex;
  flex-direction: column;
}

@media (max-width: 600px) {
  /* 1.5rem each side costs 48px of a 339px column, and these
     panels carry code blocks */
  .software-item {
    padding: 1.1rem;
  }
}

/* HEADER */

.software-title {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.software-title strong {
  font-size: 1.05rem;
}

/* =========================================================
   LANGUAGE BADGE

   The one badge left. It stays quiet — no hover state, no
   pointer cursor, muted colour — because it is a label, and
   it sits in a card whose other pills are real buttons.

   It sits beside the name because the language is a fact
   about the package rather than a description of it, and
   that is what makes it worth scanning when comparing
   several. That test is also what the keyword pills that
   used to sit below the tagline failed: each one restated
   the tagline, the research link, or a summary bullet a few
   lines further down, and being disjoint across the three
   packages they could not even show what the packages have
   in common. Removed rather than restyled.

   inline-block so the border closes around the whole label
   instead of being split across two line boxes.
========================================================= */
.badge.language {
  display: inline-block;
  max-width: 100%;

  font-size: 0.7rem;
  line-height: 1.5;
  padding: 2px 8px;

  border-radius: 999px;
  border: 1px solid var(--border-ui);
  background: transparent;

  color: var(--text-muted);
  letter-spacing: 0.02em;

  /* nudge up so it optically centres against the name */
  transform: translateY(-1px);
}

.software-tagline {
  margin-top: 0.3rem;
  font-size: 0.85rem;
  color: var(--text);
  opacity: 0.7;
}

/* the research this package came out of — context, not an
   action, so it sits on its own line rather than in the
   button row */
.research-link {
  display: inline-flex;
  align-items: baseline;
  /* the colon now separates label from value, so the gap can
     come back to a normal word space */
  gap: 0.3rem;

  /* .software-item is a flex column, and a flex item stretches
     on the cross axis by default — which here is the width. An
     inline-flex link would have been pulled the full width of
     the card, making its hover state and focus ring span the
     whole row. Only needed since the link moved out of the
     header <div> and became a flex child in its own right. */
  align-self: flex-start;

  /* more air below than above: this closes the tagline-and-
     summary block and separates it from the actions, rather
     than floating equidistant between the two */
  margin: 0.1rem 0 0.55rem;
  font-size: 0.82rem;

  color: var(--accent);
  text-decoration: none;

  transition: color 0.15s ease;
}

.research-label {
  color: var(--text-muted);
}

.research-link::after {
  content: "→";
  transition: transform 0.2s ease;
}

.research-link:hover::after {
  transform: translateX(3px);
}

/* .software-meta and the shared .badge base lived here, for the keyword
   row. Both are gone with it; the language badge above carries the few
   properties it actually used. */

/* =========================================================
   SUMMARY

   This had no rule at all, so it fell through to the global
   `ul` in Layout.astro and rendered at full body size, 20px
   indent, default disc markers — set LARGER and darker than
   the .software-tagline immediately above it, which is
   0.85rem at 0.7 opacity.

   That is the hierarchy upside down. The tagline is the
   card's one-line claim and the summary elaborates it, so
   the summary should read as the substance without
   outweighing the line it expands. 0.88rem at full --text
   sits just above the tagline: quieter in size, clearer in
   colour, which is the right pair of signals.
========================================================= */
.software-summary {
  margin: 0.7rem 0 0.35rem;
  padding-left: 1.05rem;

  /* Nothing inside the card had a measure. The page is 850px
     and the card's padding takes 48px of it, so a bullet ran
     to about 114 characters — comfortable reading is 45 to
     75. .software-intro on this same page already sets 70ch;
     the cards simply never got the same treatment. */
  max-width: 68ch;

  font-size: 0.88rem;
  line-height: 1.5;
  color: var(--text);

  /* markers drawn below rather than by the browser */
  list-style: none;
}

.software-summary li {
  position: relative;
  margin-bottom: 0.2rem;
}

/* A small accent dot instead of the default disc. Same colour formula
   as .cite-note's rule, so the two quiet markers on this page are
   recognisably the same idea. Absolutely positioned rather than styled
   through ::marker, whose colour support is the newest part of that
   pseudo-element. */
.software-summary li::before {
  content: "";

  position: absolute;
  left: -0.8rem;
  top: 0.58em;

  width: 4px;
  height: 4px;

  border-radius: 50%;
  background: color-mix(in srgb, var(--accent) 60%, var(--border-ui));
}

/* ACTIONS */
.software-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
  margin: 0.25rem 0;
}

.software-actions button,
.github-btn,
.research-btn {
  font-size: 0.8rem;
  border: 1px solid var(--border-ui);
  background: transparent;
  padding: 3px 8px;
  border-radius: 999px;
  cursor: pointer;
  color: var(--text);
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  text-decoration: none;
  white-space: nowrap;

  /* enumerated rather than `all`, so layout properties are never animated */
  transition: border-color 0.15s ease, color 0.15s ease,
              background 0.15s ease;
}

/* These had no hover response at all - the only pill buttons on the site
   that didn't. Same treatment as the publication and research pages: a
   10% accent wash, which stays lighter than the 18% pressed state so an
   open panel is still distinguishable from one you are merely pointing
   at. */
.software-actions button:hover,
.github-btn:hover,
.research-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 10%, transparent);
}

/* keep all five actions on one row on phones */
@media (max-width: 600px) {
  .software-actions {
    gap: 0.25rem;
    flex-wrap: nowrap;
  }

  .software-actions button,
  .github-btn {
    font-size: 0.74rem;
    padding: 3px 7px;
    gap: 0.25rem;
  }

  /* the mark is recognisable on its own; the label is
     what pushes the row over the edge */
  .github-btn span {
    display: none;
  }
}
/* Both selectors carry the same look. .active is what the script has
   always set; aria-expanded is the accessible disclosure state added
   alongside it, and styling from both means neither can be the only
   thing keeping the button looking right. */
.software-actions button.active,
.software-actions button[aria-expanded="true"] {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 18%, transparent);
  color: var(--accent);
  box-shadow: inset 0 1px 2px color-mix(in srgb, var(--accent) 30%, transparent);
}

/* =========================================================
   CITE LIST

   .reflist comes from styles/citations.css - the same hanging-indent
   list the research pages use for their references, imported rather
   than restyled so the two cannot drift apart.
========================================================= */

.cite-list {
  max-width: none;
}

.cite-list li {
  /* room for the copy button to sit on the same line as the reference */
  padding-right: 0;
}

/* The short label explaining WHY a work is cited - "INLA", "Nested AR(1)
   model". Set apart from the reference itself so it does not read as part
   of the citation. */
/* On its own line above the reference rather than inline before it.
   Sitting inline it read as a control butted against the text, and on a
   wrapped citation it was ambiguous where the label stopped and the
   authors began.

   It used to be a pill: 999px radius, 1px border, transparent fill -
   which is character for character the .cite-copy button sitting on the
   next line. Two things a millimetre apart, identical in shape, one
   clickable and one not. The pill is gone; what is left reads as a label
   because labels look like this and controls do not.

   No text-transform, deliberately: these notes carry "fGn" and "AR(1)",
