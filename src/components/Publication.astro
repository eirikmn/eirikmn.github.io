---
import { withMath } from "../lib/math.js";

const {
  title,
  authors,
  venue,
  year,
  abstract,
  doi,
  pdf,
  url,
  bibtex
} = Astro.props;

const myName = "Eirik Myrvoll-Nilsen";

const formattedAuthors =
  authors?.replace(myName, `<strong>${myName}</strong>`) ?? "";

// stable id
const id = `${title}-${year}`.replace(/\s+/g, "-").toLowerCase();
---

<style>
  /* =========================
     PUBLICATION CARD
  ========================= */

  .pub {
    margin-bottom: 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }

  .title {
    font-weight: 600;
    margin-bottom: 4px;
  }

  .authors {
    font-size: 0.95rem;
    margin-bottom: 6px;
  }

  .meta {
    font-size: 0.95rem;
    opacity: 0.8;
    margin-bottom: 8px;
  }

  /* =========================
     ACTION ROW
  ========================= */

  .action-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    padding: 4px 10px;
    border-radius: 999px;

    /* FIX: use UI border, not layout border */
    border: 1px solid var(--border-ui);

    background: transparent;
    color: var(--text);

    font-size: 0.85rem;
    text-decoration: none;

    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease,
                background 0.15s ease;
  }

  .action-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  /* Pressed look while the abstract is open.

     Keyed off aria-expanded, which the script already maintains, so the
     look and the announced state cannot disagree - a separate .active
     class would be a second source of truth for the same fact.

     Stronger than :hover (18% against 10%) and with an inset shadow, so
     an open button still reads as held down while the pointer is over
     it; hover alone would otherwise look identical to open. */
  .action-btn[aria-expanded="true"] {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  /* =========================
     CITE BUTTON

     The three labels are stacked in one grid cell so the button reserves
     the width of the widest once and cannot resize when clicked. The icon
     sits outside that stack, so it stays put while the word changes.

     Only the label swaps - the 📋 stays throughout, because the button is
     still the same control whatever state it is in.
  ========================= */

  .cite-label {
    display: inline-grid;
    justify-items: start;
    align-items: center;
  }

  .cite-label > span {
    grid-area: 1 / 1;
    visibility: hidden;
    white-space: nowrap;
  }

  .cite-btn[data-state="idle"]   .cite-label > span:nth-child(1),
  .cite-btn[data-state="copied"] .cite-label > span:nth-child(2),
  .cite-btn[data-state="failed"] .cite-label > span:nth-child(3) {
    visibility: visible;
  }

  .cite-btn[data-state="copied"] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .cite-btn[data-state="failed"] {
    opacity: 0.75;
  }

  /* announced to screen readers; clipped rather than hidden, because
     visibility:hidden would take it out of the accessibility tree and
     the announcement would never be read */
  .cite-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .cite-btn {
    position: relative;
  }

  /* =========================
     ABSTRACT TOGGLE
  ========================= */

  /* An SVG rather than the ▸ character.

     A text glyph sits on the baseline and carries its own side bearings,
     so its box is not centred on the triangle you can see - and the old
     scale(1.6) multiplied both offsets, which is why it read as low and
     to the left rather than merely a shade off. Rotation compounded it:
     transform-origin is the centre of the element box, not of the glyph
     inside it, so the open state swung around the wrong point.

     The path is drawn so its bounding box is exactly centred in the
     viewBox - x from 3 to 7, y from 1.5 to 8.5, both centred on 5 - which
     puts the visual centre, the box centre and the rotation origin in the
     same place. inline-flex removes the baseline gap, and the size is in
     em so it still tracks the button's font size.
  ========================= */

  .chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    transform: rotate(0deg);
  }

  .chevron svg {
    display: block;
    width: 0.9em;
    height: 0.9em;
  }

  .chevron.open {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }

  .abstract-wrapper {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.25s ease, opacity 0.2s ease;
  }

  .abstract-wrapper.open {
    opacity: 1;
    margin-top: 10px;
  }

  .abstract {
    padding: 10px 12px;

    /* FIX: use UI border */
    border: 1px solid var(--border-ui);

    border-radius: 8px;

    background: rgba(0,0,0,0.02);
    line-height: 1.6;
  }

  html.dark .abstract {
    background: rgba(255,255,255,0.03);
  }
</style>

<div class="pub" data-id={id}>

  <!-- TITLE -->
  <div class="title" set:html={withMath(title)}></div>

  <!-- AUTHORS -->
  <div class="authors" set:html={formattedAuthors}></div>

  <!-- META -->
  <div class="meta">
    {venue} • {year}
  </div>

  <!-- ACTIONS -->
  <div class="action-row">

    {abstract && (
      <button
        class="action-btn"
        data-toggle={id}
        aria-expanded="false"
        aria-controls={`panel-${id}`}
      >
        <span class="chevron" data-chevron={id}>
          <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false">
            <path d="M3 1.5 L7 5 L3 8.5 Z" fill="currentColor" />
          </svg>
        </span>
        Abstract
      </button>
    )}

    {doi && (
      <a
        href={doi}
        target="_blank"
        rel="noopener noreferrer"
        class="action-btn"
      >
        🔗 DOI
      </a>
    )}

    {pdf && (
      <a
        href={pdf}
        target="_blank"
        class="action-btn"
      >
        ⬇ PDF
      </a>
    )}

    {url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="action-btn"
      >
        🔗 Link
      </a>
    )}

    {bibtex && (
      <button class="action-btn cite-btn" data-bibtex={id} data-state="idle">
        <span class="cite-icon" aria-hidden="true">📋</span>
        <span class="cite-label">
          <span aria-hidden="true">Cite</span>
          <span aria-hidden="true">Copied</span>
          <span aria-hidden="true">Failed</span>
        </span>
        <span class="cite-live" aria-live="polite"></span>
      </button>
    )}

  </div>

  <!-- ABSTRACT -->
  {abstract && (
    <div class="abstract-wrapper" data-panel={id} id={`panel-${id}`}>
      <div class="abstract" set:html={withMath(abstract)}></div>
    </div>
  )}

  {bibtex && (
    <pre hidden data-bib={id}>{bibtex}</pre>
  )}

</div>

<script>
  /* Copy the entry's BibTeX. Reads the hidden [data-bib] block rather
     than holding a second copy of the record, and swaps a data-attribute
     instead of rewriting the label, so the button never changes width. */
  document.addEventListener("click", (e) => {
    const citeBtn = e.target.closest("[data-bibtex]");
    if (!citeBtn) return;

    const bib = document.querySelector(
      `[data-bib="${citeBtn.getAttribute("data-bibtex")}"]`
    );
    if (!bib) return;

    const live = citeBtn.querySelector("[aria-live]");
    const done = (state, message) => {
      citeBtn.dataset.state = state;
      if (live) live.textContent = message;
      clearTimeout(citeBtn._resetTimer);
      citeBtn._resetTimer = setTimeout(() => {
        citeBtn.dataset.state = "idle";
        if (live) live.textContent = "";
      }, 1500);
    };

    /* clipboard writes need a secure context and can be refused */
    navigator.clipboard?.writeText(bib.textContent).then(
      () => done("copied", "BibTeX copied to clipboard"),
      () => done("failed", "Copy failed. Select the citation manually.")
    ) ?? done("failed", "Copy failed. Select the citation manually.");
  });

  document.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-toggle]");
    if (!btn) return;

    const id = btn.getAttribute("data-toggle");
    const panel = document.querySelector(`[data-panel="${id}"]`);
    const chevron = document.querySelector(`[data-chevron="${id}"]`);

    if (!panel || !chevron) return;

    const isOpen = panel.classList.contains("open");

    /* aria-expanded carries the open state, so it does double duty:
       screen readers get proper disclosure semantics, and the CSS styles
       the pressed look off the same attribute rather than a second class
       that could drift out of step with it. */
    btn.setAttribute("aria-expanded", String(!isOpen));

    if (isOpen) {
      panel.classList.remove("open");
      panel.style.maxHeight = null;
      chevron.classList.remove("open");
    } else {
      panel.classList.add("open");
      panel.style.maxHeight = panel.scrollHeight + "px";
      chevron.classList.add("open");
    }
  });
</script>