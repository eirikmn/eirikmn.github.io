---
/* =========================================================
   RESEARCH THEME CARDS

   Used on both the home page and the research index, so the
   wording and the styling live in one place.

   The themes come from src/data/research.json, which each
   research subpage also reads for its own <h1> and intro.
   This component used to carry its own hardcoded copy, and
   the two had already drifted — the card said "Long-range
   dependence" while the page it linked to was headed
   "Long-range dependence, with climate applications".

   Fields used here:
     title    also the page's <h1>, so a card and the page it
              opens always agree
     blurb    a short teaser; deliberately NOT `summary`,
              which is the longer intro paragraph under the
              page heading. Different jobs, different lengths.
     href     where the card points
     featured whether it appears on the home page
     id       also the thumbnail filename in src/assets/themes

   Props:
     featured - render only the themes marked featured. The
                home page uses this so new themes can be added
                to /research without crowding the front page.

   The thumbnails are inlined rather than loaded via <img> so
   they can use currentColor and var(--accent), and therefore
   follow the light/dark theme with no extra work.
========================================================= */

import fs from "node:fs";
import path from "node:path";
import themes from "../data/research.json";

const dir = path.join(process.cwd(), "src/assets/themes");
const figure = (name) =>
  fs.readFileSync(path.join(dir, `${name}.svg`), "utf-8");

const { featured = false } = Astro.props;

const shown = featured ? themes.filter((t) => t.featured) : themes;
---

<ul class="themes">
  {shown.map((theme) => (
    <li>
      <div class="theme-figure" set:html={figure(theme.id)} />

      <div class="theme-body">
        <a class="theme-link" href={theme.href}>
          {theme.title}
        </a>
        <p>{theme.blurb}</p>
      </div>
    </li>
  ))}
</ul>

<style>
.themes {
  list-style: none;
  padding: 0;
  margin: 1.5rem 0;
  display: grid;
  gap: 1.25rem;
}

.themes li {
  display: grid;
  /* The illustrations carry real detail — thinning ice-core
     layers, a question mark, an ACF's trailing dots — and at a
     flat 96px most of it is below the threshold of legibility.
     Letting the column breathe on a wider viewport lets them be
     read rather than merely noticed; the clamp keeps the phone
     layout exactly as it was. */
  grid-template-columns: clamp(96px, 14vw, 150px) minmax(0, 1fr);
  gap: 1.25rem;
  align-items: center;

  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.25rem 1.5rem;

  transition: transform 0.2s ease, border-color 0.2s ease,
              background 0.2s ease, box-shadow 0.2s ease;

  /* same surface as .contact-card and the CV sections */
  background: var(--surface);
  box-shadow: var(--shadow);

  /* positioning context for the stretched link below */
  position: relative;
}

.themes li:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
  /* an accent wash on hover, over the surface rather than
     over the page, so it works from white as well as from
     the dark tint */
  background: color-mix(in srgb, var(--surface) 94%, var(--accent));
  box-shadow: var(--shadow-hover);
}

/* ---- thumbnail ---- */

.theme-figure {
  min-width: 0;
  color: var(--text);
}

.theme-figure :global(svg) {
  display: block;
  width: 100%;
  height: auto;
}

.theme-body {
  min-width: 0;
}

.themes a {
  display: flex;
  justify-content: space-between;
  align-items: center;

  font-size: 1.15rem;
  font-weight: 600;
  color: inherit;
  text-decoration: none;
}

/* STRETCHED LINK

   An invisible overlay makes the whole card clickable while
   the <a> still wraps only the title, so the link's
   accessible name stays "Long-range dependence" rather than
   the title plus the entire description. */
.themes a::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  border-radius: 12px;
}

/* focus ring belongs on the card, not just the title */
.themes a:focus-visible {
  outline: none;
}

.themes a:focus-visible::before {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.themes a::after {
  content: "→";
  transition: transform 0.2s ease;
}

.themes li:hover a::after {
  transform: translateX(4px);
}

.themes p {
  margin-top: 0.5rem;
  margin-bottom: 0;
  color: var(--text-muted);
}

@media (max-width: 560px) {
  .themes li {
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 1rem;
    padding: 1.1rem 1.2rem;
  }
}
</style>
