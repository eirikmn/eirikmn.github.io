---
/* =========================================================
   TABLE OF CONTENTS

   Built from the same `content` array the page renders, so
   it can never fall out of step with the headings.

   Same sticky-sidebar pattern as the CV, and the same
   mobile treatment: a wrapped row of pills above the
   article rather than a nested column.

   Props:
     blocks - the content array
     level  - which heading level to index (default 2)
========================================================= */

const { blocks = [], level = 2 } = Astro.props;

export function slugify(value = "") {
  return String(value)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const items = blocks
  .filter((b) => b.type === "heading" && (b.level ?? 3) === level)
  .map((b) => ({ label: b.value, id: slugify(b.value) }));
---

{items.length > 1 && (
  <nav class="toc" aria-label="On this page">
    <h2 class="toc-heading">On this page</h2>

    <ol class="toc-list">
      {items.map((item) => (
        <li>
          <a href={`#${item.id}`} class="toc-link" data-toc={item.id}>
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  /* Scroll-spy: mark the section currently in view.
     rootMargin pins the "active" line near the top of the
     viewport, so the highlight changes as a heading reaches
     the top rather than when it drifts into the middle. */

  const links = document.querySelectorAll(".toc-link");

  if (links.length) {
    const byId = new Map();
    links.forEach((a) => byId.set(a.dataset.toc, a));

    const headings = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    let active = null;

    const setActive = (id) => {
      if (id === active) return;
      byId.get(active)?.classList.remove("active");
      byId.get(id)?.classList.add("active");
      active = id;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        /* pick the topmost heading currently within the band */
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: "-90px 0px -70% 0px", threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>

<style>
.toc {
  font-size: 0.85rem;
}

.toc-heading {
  /* not a document heading — override the global h2 */
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;

  color: var(--text-muted);

  margin: 0 0 0.75rem;
  padding: 0;
  border: none;
}

.toc-list {
  list-style: none;
  margin: 0;
  padding: 0;

  display: flex;
  flex-direction: column;
  gap: 0.5rem;

  counter-reset: toc;
}

.toc-link {
  color: var(--text-muted);
  text-decoration: none;
  line-height: 1.35;

  border-left: 2px solid transparent;
  padding-left: 0.6rem;
  margin-left: -0.6rem;
  display: block;

  transition: color 0.15s ease, border-color 0.15s ease;
}

.toc-link:hover {
  color: var(--accent);
}

.toc-link.active {
  color: var(--text);
  font-weight: 600;
  border-left-color: var(--accent);
}

/* ---------------------------------------------------------
   MOBILE

   A sticky column would eat the screen, so the same wrapped
   pill row the CV sidebar uses.
--------------------------------------------------------- */

@media (max-width: 900px) {
  .toc {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .toc-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .toc-link {
    border: 1px solid var(--border);
    border-left-width: 1px;
    border-radius: 999px;

    padding: 4px 9px;
    margin-left: 0;

    font-size: 0.78rem;
    white-space: nowrap;
  }

  .toc-link.active {
    border-color: var(--accent);
    color: var(--accent);
  }
}
</style>
