---
/* =========================================================
   RESEARCH ANIMATION

   A looping, silent animation presented as a figure — the
   modern replacement for an animated GIF, at a fraction of
   the file size.

   Deliberately NOT using the `controls` attribute. Native
   controls paint a grey scrim over the frame on hover, and
   a scrubber is the wrong affordance for a 20-second loop
   that has no audio and no narrative order. Instead there
   is a single pause toggle, which is also what WCAG 2.2.2
   requires: any auto-playing motion over five seconds must
   be stoppable.

   Props:
     src      - path to the .mp4
     poster   - still frame shown before playback starts
     caption  - figcaption content. Rendered as HTML, matching
                the still-figure captions on the research
                pages, so a bold lead-in or an <em> can be
                written inline. Author-controlled only.
     aspect   - CSS aspect-ratio, reserves space to stop
                layout shift while the video loads, and is
                also parsed to a number so the stylesheet
                can cap the HEIGHT (see --ar below)
========================================================= */

const {
  src,
  poster,
  caption,
  aspect = "4 / 3"
} = Astro.props;

/* "8 / 9" -> 0.8889. The frame is sized by width, but these
   animations are portrait, so width alone is the wrong
   constraint: 2/3 at the old 600px cap stood 900px tall,
   which is more than a laptop viewport and meant the two
   panels could never be seen at once. Knowing the ratio
   numerically lets the width rule work back from a maximum
   height. If it cannot be parsed the cap drops out and the
   old width-only behaviour applies. */
function ratioOf(value) {
  const m = String(value).match(/^\s*([\d.]+)\s*(?:\/\s*([\d.]+))?\s*$/);
  if (!m) return null;
  const w = Number(m[1]);
  const h = m[2] === undefined ? 1 : Number(m[2]);
  return Number.isFinite(w) && Number.isFinite(h) && h > 0 ? w / h : null;
}

const ar = ratioOf(aspect);
const frameStyle = `aspect-ratio: ${aspect};` + (ar ? ` --ar: ${ar.toFixed(4)};` : "");

const id = `vid-${src.replace(/\W+/g, "-")}`;
const captionId = `${id}-caption`;
---

<figure class="figure video-figure">

  <div class="video-frame" style={frameStyle}>

    <video
      class="media"
      loop
      muted
      playsinline
      preload="none"
      poster={poster}
      aria-describedby={caption ? captionId : undefined}
    >
      <source src={src} type="video/mp4" />
    </video>

    <button
      type="button"
      class="video-toggle"
      data-playing="false"
      aria-label="Play animation"
    >
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M8 5v14l11-7z" />
      </svg>
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z" />
      </svg>
    </button>

  </div>

  {caption && <figcaption id={captionId} set:html={caption} />}

</figure>

<script>
  /* Astro bundles a component's script once, however many
     times the component is used on the page. */

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  document.querySelectorAll(".video-frame").forEach((frame) => {
    const video = frame.querySelector("video");
    const toggle = frame.querySelector(".video-toggle");

    /* set once the reader presses pause, so scrolling away
       and back does not override their choice */
    let pausedByUser = reduceMotion;

    /* Last resort. The custom toggle assumes the browser can
       decode the file; where it cannot, a bespoke button is
       worse than none, because it looks live and does nothing.
       So hand the element back to the browser: native controls
       report the failure in the browser's own words instead of
       failing silently.

       Kept distinct from an autoplay refusal, which is normal
       and must not trigger this. */
    let degraded = false;

    function degrade(reason) {
      if (degraded) return;
      degraded = true;

      video.controls = true;
      toggle.hidden = true;

      /* click-to-enlarge would otherwise swallow taps meant for
         the native scrubber — and there is nothing to enlarge
         to, since the lightbox would fail on the same file */
      frame.style.cursor = "default";
      video.addEventListener("click", (e) => e.stopPropagation());

      console.warn(`[ResearchVideo] ${video.currentSrc || "video"}: ${reason}`);
    }

    /* fires on a network failure and, on iOS, on a stream the
       hardware decoder refuses — a profile or level above what
       the device advertises fails here even when the picture is
       small enough to decode easily */
    video.addEventListener("error", () =>
      degrade(video.error?.message || `media error ${video.error?.code ?? ""}`)
    );

    function attemptPlay() {
      video.play().catch((err) => {
        /* NotAllowedError is the browser declining to autoplay.
           That is expected and self-correcting — the reader can
           still press the button. Anything else means the media
           itself will not run. */
        if (err?.name === "NotAllowedError") return;
        degrade(`${err?.name ?? "play() rejected"}: ${err?.message ?? ""}`);
      });
    }

    function sync() {
      const playing = !video.paused && !video.ended;
      toggle.dataset.playing = String(playing);
      toggle.setAttribute(
        "aria-label",
        playing ? "Pause animation" : "Play animation"
      );
    }

    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);

    toggle.addEventListener("click", (e) => {
      /* the frame itself opens the lightbox — don't do both */
      e.stopPropagation();

      if (video.paused) {
        pausedByUser = false;

        /* preload="none" means a reader who presses play before
           the prefetch observer has fired has nothing buffered.
           load() inside the gesture starts the fetch and keeps
           the gesture attached to the play() that follows. */
        if (video.preload === "none") {
          video.preload = "auto";
          video.load();
        }

        attemptPlay();
      } else {
        pausedByUser = true;
        video.pause();
      }
    });

    /* Stage 1: start fetching shortly before the reader
       reaches it, so playback is instant on arrival. */
    new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          video.preload = "auto";
          video.load();
          obs.disconnect();
        });
      },
      { rootMargin: "400px 0px" }
    ).observe(frame);

    /* Stage 2: only run the loop while it is actually on
       screen. Saves battery, and means the animation is at
       the start of its cycle when the reader arrives rather
       than having looped unseen a dozen times. */
    new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (!pausedByUser && !degraded) attemptPlay();
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.25 }
    ).observe(frame);

    sync();
  });
</script>

<style is:global>
  /* This <figure> is rendered by a component, so the page's
     own scoped .figure rules cannot reach it. Restate the
     two that matter: the margin reset (browsers default
     <figure> to `margin: 1em 40px`) and the caption. */
  .video-figure {
    margin: 1em 0;

    /* shares the page's figure counter, so an animation sitting
       between two stills doesn't break the numbering */
    counter-increment: figure;
  }

  .video-figure figcaption {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.4rem;
    line-height: 1.45;
  }

  .video-figure figcaption::before {
    content: "Figure " counter(figure) ". ";
    font-weight: 600;
    color: var(--text);
  }

  /* A bold lead-in runs straight on from that "Figure N." prefix, so
     it has to match it: the browser default for <b> is 700, and the
     caption body colour is --text-muted, which together would put a
     visible seam in the middle of one continuous bold phrase. */
  .video-figure figcaption :is(b, strong) {
    font-weight: 600;
    color: var(--text);
  }

  .video-frame {
    position: relative;

    /* Sized by width, but bounded by height as well. The three
       candidates are: never overflow the column (100%), never
       exceed the design width (600px), and never stand taller
       than --vid-max-h — which, since height = width / --ar,
       means a width of --vid-max-h * --ar.

       The 999 fallback makes the third candidate lose whenever
       the component could not parse the aspect, leaving the
       original width-only behaviour intact. */
    --vid-max-h: 66vh;
    width: min(100%, 600px, calc(var(--vid-max-h) * var(--ar, 999)));
    margin: 1rem auto;

    border-radius: 8px;
    border: 1px solid var(--border-ui);
    overflow: hidden;

    /* The animations are plotted on white, so the stage is
       white — both to be faithful to the artwork and to stop
       dark mode showing through behind it.

       It used to be #fafafa against a #ffffff page, which made
       the plate a shade DARKER than what surrounded it and left
       it reading as nothing at all. Now the page is off-white
       and the plate is true white, so the same 1.05 of
       separation works in the other direction and the figure
       lifts. */
    background: #ffffff;

    cursor: zoom-in;
  }

  /* dim in dark mode, matching the still figures. Applied to the
     video rather than the frame: a filter on the frame creates a
     containing block for its absolutely-positioned children and
     would dim the pause button along with the picture. */
  html.dark .video-frame video.media {
    filter: brightness(0.9);
  }

  .video-frame video.media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;

    /* border and radius live on the frame */
    border: none;
    border-radius: 0;
    margin: 0;
  }

  /* ---- pause / play toggle ---- */

  .video-toggle {
    position: absolute;
    right: 10px;
    bottom: 10px;

    width: 36px;
    height: 36px;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #ffffff;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;

    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, background 0.15s ease;
  }

  .video-toggle svg {
    width: 16px;
    height: 16px;
  }

  /* A 36px circle is the right visual weight over the plot but
     is under the 44px minimum touch target, and a near-miss is
     not a no-op here: it lands on the frame, which opens the
     lightbox instead of starting playback. Extend the hit area
     outward rather than growing the circle. */
  .video-toggle::after {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
  }

  /* show on hover, on keyboard focus, and whenever the
     animation is stopped so there is always a way back */
  .video-frame:hover .video-toggle,
  .video-toggle:focus-visible,
  .video-toggle[data-playing="false"] {
    opacity: 1;
  }

  .video-toggle:hover {
    background: rgba(0, 0, 0, 0.78);
    border-color: #ffffff;
  }

  /* swap the icon to match state */
  .video-toggle[data-playing="true"] .icon-play,
  .video-toggle[data-playing="false"] .icon-pause {
    display: none;
  }

  /* touch devices have no hover, so keep it visible */
  @media (hover: none) {
    .video-toggle {
      opacity: 1;
    }
  }

  /* the script sets `hidden` and turns on native controls when
     the browser cannot play the file; `display: flex` above
     outranks the user-agent `hidden` rule, as it does for the
     lightbox media */
  .video-toggle[hidden] {
    display: none;
  }
</style>
