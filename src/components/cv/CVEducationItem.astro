---
const {
  degree,
  field,
  institution,
  location,
  start,
  end,
  thesis,
  supervisors,
  bullets,
  logo
} = Astro.props;

/* =========================
   LOGO NORMALISATION
========================= */

function normalizeLogo(logo) {
  if (!logo) return null;

  if (typeof logo === "string") {
    return {
      light: logo,
      dark: logo
    };
  }

  return {
    light: logo.light ?? logo.fallback ?? logo.dark,
    dark: logo.dark ?? logo.light ?? logo.fallback
  };
}

const normalizedLogo = normalizeLogo(logo);

/* supervisors */
let supervisorList = [];

if (Array.isArray(supervisors)) {
  supervisorList = supervisors;
} else if (typeof supervisors === "string") {
  supervisorList = supervisors.split(",").map(s => s.trim());
}
---

<div class="cv-item">

  {normalizedLogo && (
    <div class="cv-logo-wrapper">

      <!-- LIGHT -->
      <img
        src={`/icons/${normalizedLogo.light}`}
        class="cv-logo cv-logo-light"
        alt={`${institution} logo`}
      />

      <!-- DARK -->
      <img
        src={`/icons/${normalizedLogo.dark}`}
        class="cv-logo cv-logo-dark"
        alt={`${institution} logo`}
      />

    </div>
  )}

  <div class="cv-content">

    <div class="cv-item-header">
      <strong>
        {degree}{field ? `, ${field}` : ""}
      </strong>

      <span class="cv-dates">
        {start} – {end ?? "Present"}
      </span>
    </div>

    <div class="cv-sub">
      {institution}{location ? ` · ${location}` : ""}
    </div>

    {thesis && (
      <div class="cv-thesis">
        <em>Thesis:</em> {thesis}
      </div>
    )}

    {supervisorList.length > 0 && (
      <div class="cv-supervisors">
        <em>Supervisors:</em>{" "}
        {supervisorList.map((s, i) => (
          <span>
            {s}{i < supervisorList.length - 1 ? "," : ""}
          </span>
        ))}
      </div>
    )}

    {bullets && (
      <ul class="cv-bullets">
        {bullets.map((b) => <li>{b}</li>)}
      </ul>
    )}

  </div>

</div>

<style>
.cv-item {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 1rem;
  border-left: 2px solid var(--accent);
  padding-left: 1rem;
  margin-bottom: 1.5rem;
}

/* logo */
.cv-logo-wrapper {
  width: 36px;
  height: 36px;
  position: relative;
}

.cv-logo {
  width: 36px;
  height: 36px;
  object-fit: contain;
  position: absolute;
  top: 0;
  left: 0;
}

/* default */
.cv-logo-dark {
  display: none;
}

/* ✅ IMPORTANT FIX (same as CVWorkItem) */
:global(html.dark) .cv-logo-light {
  display: none;
}

:global(html.dark) .cv-logo-dark {
  display: block;
}

/* content */
.cv-content {
  display: flex;
  flex-direction: column;
}

.cv-item-header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
}

.cv-dates {
  color: var(--text-muted);
  font-size: 0.9rem;
  white-space: nowrap;
}

.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 0.3rem;
}

.cv-thesis,
.cv-supervisors {
  font-size: 0.9rem;
  margin-bottom: 0.3rem;
}

.cv-bullets {
  margin: 0;
  padding-left: 1.2rem;
}

.cv-bullets li {
  margin-bottom: 0.3rem;
}
</style>