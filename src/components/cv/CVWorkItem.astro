---
/* =========================================================
   CV ENTRY

   Handles both work experience and education entries.
   Work data uses `title` + `company`; education data uses
   `degree` + `field` + `institution`, plus the optional
   `thesis` and `supervisors` fields. Both shapes can be
   spread straight from their JSON file.

   Shared styling lives in src/styles/cv.css.
========================================================= */

import { formatRange } from "../../lib/dates.js";

const {
  /* work */
  title,
  company,
  description,

  /* education */
  degree,
  field,
  institution,
  thesis,
  thesisUrl,
  supervisors,

  /* shared */
  location,
  start,
  end,
  bullets,
  logo
} = Astro.props;

/* heading */
const heading =
  title ?? [degree, field].filter(Boolean).join(", ");

/* organisation */
const org = company ?? institution;

/* =========================
   LOGO NORMALISATION

   `logo` may be a bare string or an object. Backfill the
   missing variant so dark mode never ends up with no logo
   at all — .cv-logo-light is hidden in dark mode, so a
   light-only entry would otherwise render nothing.
========================= */

function normalizeLogo(value) {
  if (!value) return null;

  if (typeof value === "string") {
    return { light: value, dark: value };
  }

  return {
    light: value.light ?? value.fallback ?? value.dark,
    dark: value.dark ?? value.light ?? value.fallback
  };
}

const normalizedLogo = normalizeLogo(logo);

/* =========================
   EXTRA DETAIL ROWS
   (education only, in practice)
========================= */

const supervisorText = Array.isArray(supervisors)
  ? supervisors.join(", ")
  : supervisors;

/* `href` is optional: the PhD thesis is deposited and has a
   permanent handle, so its title links to it. The MSc thesis
   has no such record and simply renders as text. */
const extras = [
  { label: "Thesis", value: thesis, href: thesisUrl },
  { label: "Supervisors", value: supervisorText }
].filter((row) => row.value);

const dateRange = formatRange(start, end);
---

<div class:list={["cv-item", normalizedLogo && "cv-item--logo"]}>

  {normalizedLogo && (
    <div class="cv-logo-wrapper">

      <!-- LIGHT LOGO -->
      <img
        src={`/icons/${normalizedLogo.light}`}
        alt={`${org} logo`}
        class="cv-logo cv-logo-light"
      />

      <!-- DARK LOGO -->
      <img
        src={`/icons/${normalizedLogo.dark}`}
        alt={`${org} logo`}
        class="cv-logo cv-logo-dark"
      />

    </div>
  )}

  <div class="cv-content">

    <div class="cv-item-header">
      <strong>{heading}</strong>

      {dateRange && (
        <span class="cv-dates">{dateRange}</span>
      )}
    </div>

    <div class="cv-sub">
      {org}{location ? ` · ${location}` : ""}
    </div>

    {extras.map((row) => (
      <div class="cv-extra">
        <em>{row.label}:</em>{" "}
        {row.href ? (
          <a
            class="link"
            href={row.href}
            target="_blank"
            rel="noopener noreferrer"
          >{row.value}</a>
        ) : row.value}
      </div>
    ))}

    {bullets ? (
      <ul class="cv-bullets">
        {bullets.map((b) => <li>{b}</li>)}
      </ul>
    ) : description ? (
      <p class="cv-description">{description}</p>
    ) : null}

  </div>

</div>

<style>
/* only what differs from src/styles/cv.css */

.cv-sub {
  margin-bottom: 0.35rem;
}

.cv-extra {
  font-size: 0.9rem;
  margin-bottom: 0.3rem;
}

.cv-description {
  margin: 0;
}
</style>
