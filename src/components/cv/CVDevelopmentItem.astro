---
const {
  title,
  organization,
  url,
  start,
  end,
  period
} = Astro.props;

const time =
  start && end
    ? `${start} – ${end}`
    : period ?? "";
---

<div class="cv-item">

  <!-- HEADER ROW (LIKE TEACHING ITEM) -->
  <div class="cv-item-header">

    <div class="cv-left">
      <strong>{title}</strong>
    </div>

    <div class="cv-right">
      {time}
    </div>

  </div>

  <!-- ORGANIZATION -->
  <div class="cv-sub">
    {organization}
  </div>

  <!-- ACTION BUTTON -->
  {url && (
    <div class="cv-actions">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="cv-button"
      >
        View course
      </a>
    </div>
  )}

</div>

<style>
.cv-item {
  border-left: 2px solid var(--accent);
  padding-left: 1rem;
  margin-bottom: 0.6rem;

  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* 🔑 THIS is the important fix */
.cv-item-header {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;
  gap: 1rem;
}

.cv-left {
  font-weight: 600;
  color: var(--text);
}

.cv-right {
  font-size: 0.85rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
}

/* button */
.cv-actions {
  margin-top: 0.25rem;
}

.cv-button {
  display: inline-block;
  font-size: 0.85rem;
  padding: 2px 10px;
  border-radius: 999px;

  border: 1px solid var(--border);
  color: var(--text);
  text-decoration: none;

  transition: 0.15s ease;
}

.cv-button:hover {
  border-color: var(--accent);
  color: var(--accent);
}
</style>