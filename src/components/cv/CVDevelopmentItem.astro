---
import { formatDate, formatRange } from "../../lib/dates.js";

const {
  title,
  organization,
  url,
  start,
  end,
  period
} = Astro.props;

const time = (start || end)
  ? formatRange(start, end)
  : formatDate(period) ?? "";
---

<div class="cv-item">

  <!-- HEADER ROW (LIKE TEACHING ITEM) -->
  <div class="cv-item-header">

    <div class="cv-left">
      <strong>{title}</strong>
    </div>

    <div class="cv-right">
      {time}
    </div>

  </div>

  <!-- ORGANIZATION -->
  <div class="cv-sub">
    {organization}
  </div>

  <!-- ACTION BUTTON -->
  {url && (
    <div class="cv-actions">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="cv-button"
      >
        View course
      </a>
    </div>
  )}

</div>

<style>
/* only what differs from src/styles/cv.css */

/* this entry type has no .cv-content wrapper, so the
   flex column lives on the item itself */
.cv-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* grid rather than flex so the date column is `auto`
   and the title takes the remaining space */
.cv-item-header {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;
  gap: 1rem;
}

.cv-left {
  font-weight: 600;
  color: var(--text);
}

.cv-right {
  font-size: 0.85rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
}

/* button */
.cv-actions {
  margin-top: 0.25rem;
}

/* Matches .toggle-btn in CVTeachingItem — the two are the
   same object in different sections and had drifted apart.

   --border-ui, not --border: against the card's tinted fill
   the layout token lands at 1.25:1, which is not an edge.
   The UI token reaches 1.83:1 in light mode and 4.92:1 in
   dark.

   The background is the page colour rather than transparent,
   so the pill sits a step above the tinted card instead of
   dissolving into it. */
.cv-button {
  display: inline-block;
  font-size: 0.8rem;
  padding: 3px 10px;
  border-radius: 999px;

  border: 1px solid var(--border-ui);
  background: var(--bg);
  color: var(--text);
  text-decoration: none;

  /* enumerated, not `all`: the shorthand animates layout
     properties too and can cause jank */
  transition: border-color 0.15s ease, color 0.15s ease,
              background 0.15s ease;
}

.cv-button:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 12%, var(--bg));
}
</style>