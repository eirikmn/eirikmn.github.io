---
import { formatDate, formatRange } from "../../lib/dates.js";

const {
  title,
  organization,
  start,
  end,
  details,
  period,
  count,
  bullets
} = Astro.props;

/* Two ways to say more about an entry, and which one you use
   decides how it is presented.

   `details` is one short line — a gloss, always visible, the
   way the session chair names its session. Folding a sentence
   behind a click costs the reader more attention than the
   sentence does.

   `bullets` is a list, and gets a Details button. That is the
   threshold: a disclosure earns its place when there is enough
   behind it that showing it outright would push the next entry
   off the screen. The presidency of a national organisation
   plausibly clears that; a one-line note does not.

   Entries with neither render no button at all, so the seven
   governance rows stay as clean as they are now. */
const id = [title, organization, period, start]
  .filter(Boolean)
  .join("-")
  .replace(/\W+/g, "-")
  .toLowerCase();

/* `period` is a single stored value ("2022", "Spring 2024",
   "2025-03"); start/end is a range. formatDate and
   formatRange both pass non-ISO values through untouched. */
const formattedTime = period
  ? formatDate(period)
  : formatRange(start, end);

/* A peer-review entry has no organization to give — the
   journal IS the title — but it does have a number of
   reviews, and that number used to be stored in
   `organization` as the words "Three times". A frequency was
   sitting in the slot every other entry on the page uses for
   an institution, and because it was prose it also had to be
   written out by hand, which is why one entry said "Three
   times" and the other "Once" rather than agreeing on a form.

   A dedicated `count` lets the singular and plural be derived
   instead, and leaves `organization` meaning one thing
   everywhere. */
const reviewCount =
  Number.isFinite(count) ? `${count} ${count === 1 ? "review" : "reviews"}` : null;

const subtitle = organization ?? reviewCount;
---

<div class="cv-item">

  <div class="cv-content">

    <!-- HEADER -->
    <div class="cv-item-header">

      {/* Title and button are ONE flex child. The header is
          justify-content: space-between, so three children put
          the button in the gap between the title and the date —
          floating in dead space, attached to neither. Grouped,
          the row is two parts again: identity left, date hard
          right, where every other entry on the page has it. */}
      <span class="cv-item-title">
        <strong>
          {title}
        </strong>

        {bullets?.length > 0 && (
          <button
            class="toggle-btn"
            data-toggle={id}
            aria-expanded="false"
            aria-controls={id}
          >
            <span class="toggle-label toggle-label--show">Details</span>
            <span class="toggle-label toggle-label--hide">Hide</span>
          </button>
        )}
      </span>

      {formattedTime && (
        <span class="cv-dates">
          {formattedTime}
        </span>
      )}

    </div>

    {/* Conditional, not always-rendered. Entries with neither an
        organization nor a review count — the reading group, the
        exhibition before its host was filled in — were emitting an
        empty <div> that still carried its 0.25rem bottom margin, so
        those entries sat on a little more air than their neighbours
        for no visible reason. */}
    {subtitle && (
      <div class="cv-sub">
        {subtitle}
      </div>
    )}

    <!-- OPTIONAL DETAILS -->
    {details && (
      <div class="cv-details">
        {details}
      </div>
    )}

    {bullets?.length > 0 && (
      <div class="cv-collapse" id={id} data-panel={id}>
        <ul class="cv-bullets">
          {bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </div>
    )}

  </div>

</div>

<style>
/* only what differs from src/styles/cv.css */

/* slightly smaller dates than the shared default */
.cv-dates {
  font-size: 0.85rem;
}

/* ORGANIZATION */
.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}

/* OPTIONAL DETAILS */
.cv-details {
  font-size: 0.85rem;
  color: var(--text-muted);
}
</style>