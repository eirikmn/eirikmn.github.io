---
import { formatDate, formatRange } from "../../lib/dates.js";

const {
  title,
  organization,
  start,
  end,
  details,
  period
} = Astro.props;

/* `period` is a single stored value ("2022", "Spring 2024",
   "2025-03"); start/end is a range. formatDate and
   formatRange both pass non-ISO values through untouched. */
const formattedTime = period
  ? formatDate(period)
  : formatRange(start, end);
---

<div class="cv-item">

  <div class="cv-content">

    <!-- HEADER -->
    <div class="cv-item-header">

      <strong>
        {title}
      </strong>

      {formattedTime && (
        <span class="cv-dates">
          {formattedTime}
        </span>
      )}

    </div>

    <!-- ORGANIZATION -->
    <div class="cv-sub">
      {organization}
    </div>

    <!-- OPTIONAL DETAILS -->
    {details && (
      <div class="cv-details">
        {details}
      </div>
    )}

  </div>

</div>

<style>
/* only what differs from src/styles/cv.css */

/* slightly smaller dates than the shared default */
.cv-dates {
  font-size: 0.85rem;
}

/* ORGANIZATION */
.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}

/* OPTIONAL DETAILS */
.cv-details {
  font-size: 0.85rem;
  color: var(--text-muted);
}
</style>