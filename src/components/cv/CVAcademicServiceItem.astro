---
const {
  title,
  organization,
  start,
  end,
  details,
  period
} = Astro.props;

const formattedTime =
  period ?? (start || end
    ? `${start ?? "—"} – ${end ?? "Present"}`
    : null);
---

<div class="cv-item">

  <div class="cv-content">

    <!-- HEADER -->
    <div class="cv-item-header">

      <strong>
        {title}
      </strong>

      {formattedTime && (
        <span class="cv-dates">
          {formattedTime}
        </span>
      )}

    </div>

    <!-- ORGANIZATION -->
    <div class="cv-sub">
      {organization}
    </div>

    <!-- OPTIONAL DETAILS -->
    {details && (
      <div class="cv-details">
        {details}
      </div>
    )}

  </div>

</div>

<style>
/* only what differs from src/styles/cv.css */

/* slightly smaller dates than the shared default */
.cv-dates {
  font-size: 0.85rem;
}

/* ORGANIZATION */
.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}

/* OPTIONAL DETAILS */
.cv-details {
  font-size: 0.85rem;
  color: var(--text-muted);
}
</style>