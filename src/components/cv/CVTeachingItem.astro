---
const {
  role,
  institution,
  location,
  courses,
  responsibilities
} = Astro.props;

const id = `${role}-${institution}`
  .replace(/\s+/g, "-")
  .toLowerCase();
---

<div class="cv-item">

  <div class="cv-content">

    <!-- HEADER -->
    <div class="cv-item-header">
      <strong>{role}</strong>

      {responsibilities && (
        <button
          class="toggle-btn"
          data-toggle={id}
          aria-expanded="false"
          aria-controls={id}
        >
          <span class="toggle-label toggle-label--show">Details</span>
          <span class="toggle-label toggle-label--hide">Hide</span>
        </button>
      )}
    </div>

    <!-- INSTITUTION -->
    <div class="cv-sub">
      {institution}{location ? ` · ${location}` : ""}
    </div>

    <!-- COURSES -->
    {courses && (
      <div class="cv-courses">
        {courses.map((c) => (
          <div class="cv-course">
            <span class="cv-course-title">
              {c.code} – {c.name}
            </span>

            {/* Each term is its own nowrap span rather than
                one joined string, so that on a narrow screen
                the list can break between terms — "Spring
                2013," / "Spring 2014" — but never inside one,
                which would strand a bare "2013" on a line. */}
            <span class="cv-course-periods">
              {c.periods.map((p, i) => (
                <>
                  <span class="cv-period">{p}</span>{i < c.periods.length - 1 ? ", " : ""}
                </>
              ))}
            </span>
          </div>
        ))}
      </div>
    )}

    <!-- RESPONSIBILITIES -->
    {responsibilities && (
      <div class="cv-collapse" id={id} data-panel={id}>
        <ul class="cv-bullets">
          {responsibilities.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </div>
    )}

  </div>

</div>

<script>
  document.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-toggle]");
    if (!btn) return;

    const id = btn.getAttribute("data-toggle");
    const panel = document.querySelector(`[data-panel="${id}"]`);
    if (!panel) return;

    const isOpen = panel.classList.contains("open");

    if (isOpen) {
      panel.classList.remove("open");
      panel.style.maxHeight = null;
      btn.setAttribute("aria-expanded", "false");
    } else {
      panel.classList.add("open");
      panel.style.maxHeight = panel.scrollHeight + "px";
      btn.setAttribute("aria-expanded", "true");
    }
  });
</script>

<style>
/* only what differs from src/styles/cv.css */

/* centre rather than baseline: the right-hand slot
   holds a button, not text */
.cv-item-header {
  align-items: center;
}

/* =========================
   BUTTON (IMPROVED CONTRAST)
========================= */
.toggle-btn {
  font-size: 0.8rem;

  /* The label alternates between "Details" and "Hide", which
     are different widths. If the button were free to resize,
     it would shift on every click, and a role title long
     enough to wrap would re-flow against the new free space.

     Both labels therefore share one grid cell: the button is
     permanently as wide as the wider of the two, and only
     visibility changes. flex: none keeps a long title from
     squeezing it either. */
  display: inline-grid;
  text-align: center;
  flex: none;

  /* --border-ui rather than a hand-rolled color-mix. Against
     the card's tinted fill this reaches 1.83:1 in light mode
     and 4.92:1 in dark, and it is the same token the card
     edge and the publication action buttons use — so it no
     longer needs a separate dark-mode correction below.

     The page background rather than transparent, so the pill
     lifts off the tint instead of dissolving into it. */
  border: 1px solid var(--border-ui);
  background: var(--bg);

  padding: 3px 10px;
  border-radius: 999px;

  cursor: pointer;
  color: var(--text);

  transition: border-color 0.15s ease, color 0.15s ease,
              background 0.15s ease;
}

/* stack, don't sit side by side */
.toggle-label {
  grid-area: 1 / 1;
}

/* visibility rather than display, so the hidden label still
   contributes its width — and is still hidden from screen
   readers, which display: none would also do but at the cost
   of the reserved space */
.toggle-btn[aria-expanded="false"] .toggle-label--hide,
.toggle-btn[aria-expanded="true"] .toggle-label--show {
  visibility: hidden;
}

/* Mixed into var(--bg), not transparent: the pill now has a
   background of its own, so mixing into transparent would
   let the card's tint show through and muddy the hover. */
.toggle-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 12%, var(--bg));
}

/* =========================
   SUBTEXT
========================= */
.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

/* =========================
   COURSES
========================= */
/* Column with a gap rather than margins on the rows: the
   spacing then belongs to the list, so the first and last
   course can't pick up a stray edge margin that fights
   .cv-courses' own margin-bottom. */
/* 0.7rem between courses, against 0.1rem inside one. The
   old values were 0.3 and 0.15 — close enough that a wrapped
   date line sat almost as far from its own course as from
   the next one, and read as belonging to the course below. */
.cv-courses {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;

  margin-bottom: 0.5rem;
}

/* Course name left, terms right. When the two together are
   wider than the column — "TDT4102 – Procedural and
   Object-Oriented Programming" beside "Spring 2013, Spring
   2014" is the longest pairing here — the terms are what
   should stay whole, and the course name is what should
   give. Three rules do that:

     flex-wrap        the terms drop to their own line rather
                      than being crushed
     row-gap 0.15rem  keeps that second line tight to the
                      course it belongs to, well inside the
                      0.3rem between courses
*/
/* The binding row is "TDT4102 – Procedural and Object-
   Oriented Programming" beside "Spring 2013, Spring 2014":
   52 characters against 24, the longest pairing on the page.
   At the old sizes that needed ~600px in a 562px column, so
   it wrapped.

   Courses are supporting detail under the role, so a step
   down in size is legitimate rather than a fudge: the title
   drops to 0.85rem and the terms to 0.8rem. With the wider
   column (see cv.astro and CVSection) the worst row now
   needs ~570px of ~590px. */
/* A two-column grid, not a wrapping flex row.

   Flex-wrap moved the whole terms block onto a line of its
   own whenever the pair was too wide, which is what made it
   ambiguous — a date sitting alone on a line has nothing to
   say which course it belongs to.

   In a grid the terms have their own column and never leave
   it: they always sit on the first line of their course, and
   it is the course name that wraps beneath itself instead.
   The association is then unmistakable at any width.

     minmax(0, 1fr)  the title column, free to shrink and wrap
     auto            the terms column, exactly as wide as the
                     terms need and no wider */
.cv-course {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  column-gap: 0.75rem;
  row-gap: 0.1rem;
  align-items: baseline;

  font-size: 0.85rem;
}

.cv-course-title {
  min-width: 0;
}

.cv-course-periods {
  color: var(--text-muted);
  font-size: 0.8rem;
  text-align: right;
}

/* The unbreakable unit is one term, not the whole list. On a
   wide screen the auto track is max-content, so the list sits
   on one line anyway and this changes nothing. */
.cv-period {
  white-space: nowrap;
}

/* ---------------------------------------------------------
   PHONES

   Same shape as desktop — name left, terms right — rather
   than stacking, which put the terms where they could be
   mistaken for the next course.

   The columns become proportional instead of "as wide as the
   terms need". At 2fr / 1fr on a 342px column that is 220px
   for the name and 110px for the terms: the name wraps to
   two lines, and the terms wrap to one term per line, which
   is why each term is its own nowrap span above.

     TDT4102 – Procedural and      Spring 2013,
     Object-Oriented Programming   Spring 2014
--------------------------------------------------------- */

@media (max-width: 560px) {
  .cv-course {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }
}


/* =========================
   COLLAPSIBLE
========================= */
.cv-collapse {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.25s ease, opacity 0.2s ease;
}

.cv-collapse.open {
  opacity: 1;
}

.cv-bullets {
  margin: 0.5rem 0 0 0;
  padding-left: 1.2rem;
}

.cv-bullets li {
  margin-bottom: 0.3rem;
}

/* =========================
   DARK MODE

   Nothing to correct any more. These used to hand-mix a
   stronger border and a stronger hover for dark mode; both
   are now handled by the tokens themselves — --border-ui is
   already #8a8a8a in dark against #b8b8b8 in light, and the
   hover mixes into var(--bg), which flips with the theme.

   The old override was also actively harmful once the base
   moved to --border-ui: html.dark is more specific, so it
   won, and it resolved to roughly #6a6a6a — weaker than the
   token it was overriding.
========================= */
</style>