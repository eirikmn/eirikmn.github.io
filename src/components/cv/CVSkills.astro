---
const { skills } = Astro.props;

const formatTitle = (key) => {
  const map = {
    programming: "Programming",
    frameworks: "Statistical Frameworks",
    tools: "Tools",
    languages: "Languages",
  };

  return map[key] ?? key;
};
---

<div class="cv-skills">

  {Object.entries(skills).map(([category, items]) => (
    <div class="cv-item">

      <div class="cv-item-header">
        <strong>{formatTitle(category)}</strong>
      </div>

      <div class="cv-sub">
        {items.join(" · ")}
      </div>

    </div>
  ))}

</div>

<style>
.cv-skills {
  display: flex;
  flex-direction: column;

  /* Increased vertical spacing between skill groups */
  gap: 0.65rem;
}

/* only what differs from src/styles/cv.css */

/* category title */
.cv-item-header {
  margin-bottom: 0.2rem;
}

/* skill content */
.cv-sub {
  line-height: 1.3;
}
</style>