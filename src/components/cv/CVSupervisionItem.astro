---
import { formatRange } from "../../lib/dates.js";

const {
  candidate,
  institution,
  location,
  start,
  end,
  project,
  role,
  roleTimeline
} = Astro.props;

const dateRange = formatRange(start, end);

const formatRole = (roles) => {
  if (!roles || roles.length === 0) return null;

  return roles
    .map((r) => `${r.role} (${formatRange(r.start, r.end)})`)
    .join(" → ");
};
---

<div class="cv-item">

  <div class="cv-content">

    <!-- HEADER -->
    <div class="cv-item-header">
      <strong>{candidate}</strong>

      {dateRange && (
        <span class="cv-dates">{dateRange}</span>
      )}
    </div>

    <!-- ROLE (primary signal) -->
    {role && (
      <div class="cv-role">
        {role}
      </div>
    )}

    <!-- INSTITUTION -->
    <div class="cv-sub">
      {institution}{location ? ` · ${location}` : ""}
    </div>

    <!-- PROJECT -->
    {project && (
      <div class="cv-project">
        {project}
      </div>
    )}

    <!-- ROLE TIMELINE -->
    {roleTimeline && roleTimeline.length > 0 && (
      <div class="cv-role-timeline">
        {formatRole(roleTimeline)}
      </div>
    )}

  </div>

</div>

<style>
/* only what differs from src/styles/cv.css */

/* ROLE (important: supervisory authority) */
.cv-role {
  font-size: 0.95rem;
  font-weight: 500;
  margin-top: 0.2rem;
  margin-bottom: 0.35rem;
}

/* INSTITUTION */
.cv-sub {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 0.35rem;
}

/* PROJECT */
.cv-project {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 0.25rem;
}

/* ROLE TIMELINE */
.cv-role-timeline {
  font-size: 0.85rem;
  color: var(--text-muted);
}
</style>