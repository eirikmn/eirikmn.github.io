---
import Layout from "../layouts/Layout.astro";
/* the home page's own publication card: stacked title /
   authors / venue with the chevron-toggled abstract.
   /publications uses Publication-list.astro, which is the
   denser two-column list style. */
import Publication from "../components/Publication.astro";
import ThemeCards from "../components/ThemeCards.astro";
/* the shared "All …" pill, also used on the CV and the
   research subpages */
import "../styles/more-link.css";
import { loadBib } from "../lib/bib";
import profile from "../data/cvheader.json";
import newsData from "../data/news.json";

const news = [...newsData].sort(
  (a, b) => new Date(b.date) - new Date(a.date)
);

/* Selected publications are chosen by citation key rather than
   retyped, so titles, venues, DOIs and abstracts stay in step
   with papers.bib and the /publications page. */
const FEATURED = [
  "myrvoll2025bayesian",
  "myrvoll2025synchronization",
  "Sorbye2019"
];

const papers = loadBib("./src/data/papers.bib");

const selected = FEATURED
  .map((key) => papers.find((p) => p.key === key))
  .filter(Boolean);
---

<Layout
  title="Eirik Myrvoll-Nilsen"
  description="Postdoctoral research fellow at UiT The Arctic University of Norway. I work mostly with Bayesian statistical methods in fields such as climate science, deep learning and data integration."
>

  <section>

    <!-- PROFILE HEADER -->
    <div class="profile-header">

      {/* width/height are the INTRINSIC pixel dimensions, not the
          display size — the CSS clamp still governs how big it is
          drawn. Giving them lets the browser reserve the right
          box before the file arrives, instead of reflowing the
          whole hero when it lands. It is the largest image on the
          site and it sits at the top of the first page. */}
      <img
        src="/profile.jpg"
        alt="Eirik Myrvoll-Nilsen"
        width="800"
        height="1067"
        fetchpriority="high"
        decoding="async"
      />

      <div class="intro">
        {/* Same treatment as the header wordmark: the given
            name lighter, the surname carrying the weight. It is
            the same object in both places, and a wordmark only
            accumulates recognition by being repeated. Size and
            tracking still differ by context, which is correct —
            a 1.85rem heading and a 1.1rem mark want different
            optical settings. */}
        <h1><span class="given">Eirik</span> <span class="family">Myrvoll-Nilsen</span></h1>

        <p class="tagline">
          {profile.title} · {profile.affiliation.institution}
        </p>

        <p>
          I am a Bayesian statistician working primarily with latent Gaussian models, deep learning and data integration. Most of my work has been focused on applications in climate science, including long-range dependence, uncertainty quantification and synchronization of paleoclimate proxy records, and early warning signals ahead of tipping points. 
        </p>

        <p>
          I'm always happy to discuss research ideas, potential collaborations,
          or student projects. <a href="/contact">Contact me</a> if you are
          interested.
        </p>
      </div>

    </div>

    <!-- RESEARCH -->
    <h2>Research</h2>

    <p>
      The main directions I work in. Each has a page with the methods,
      figures and papers behind it.
    </p>

    {/* featured only, so new themes can be added to /research
        without crowding the front page */}
    <ThemeCards featured />

    <p class="more">
      <a class="more-link more-link--lg" href="/research">All research themes</a>
    </p>

    <!-- SELECTED PUBLICATIONS -->
    <h2>Selected publications</h2>

    <div class="pub-feature-list">
      {selected.map((paper) => (
        <Publication
          title={paper.title}
          authors={paper.authors}
          venue={paper.journal || paper.school}
          year={paper.year}
          abstract={paper.abstract}
          doi={paper.doi}
          pdf={paper.pdf}
          url={paper.url}
          bibtex={paper.bibtex}
        />
      ))}
    </div>

    <p class="more">
      <a class="more-link more-link--lg" href="/publications">All publications</a>
    </p>

    <!-- NEWS -->
    {news.length > 0 && (
      <>
        <h2>News</h2>

        <ul class="news-list">
          {news.map((item) => (
            <li class="news-item">
              <div class="news-date">
                {new Date(item.date).toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "short",
                  day: "numeric"
                })}
              </div>

              <div class="news-content">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                {item.url && (
                  <p>
                    <a href={item.url}>Read more →</a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </>
    )}

  </section>

</Layout>

<style>
/* =========================
   PROFILE HEADER
========================= */

.profile-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 40px;
}

.profile-header img {
  width: clamp(150px, 15vw, 180px);
  height: clamp(150px, 15vw, 180px);
  flex-shrink: 0;

  border-radius: 50%;
  object-fit: cover;

  /* No ring. The 2px --border outline predates the shadow scale,
     and with real elevation available a grey circle around a
     circular photo is a second edge doing the first one's job.

     Two layers: a close contact shadow that seats the photo on
     the page, and a wide soft one that does the lifting. One
     layer at a single blur reads as a smudge at this size. */
  box-shadow:
    0 2px 6px color-mix(in srgb, var(--text) 7%, transparent),
    0 10px 24px color-mix(in srgb, var(--text) 16%, transparent);
}

/* In dark mode --text is near-white, so the same formula
   produces a glow rather than a shadow — which is right, but it
   wants different geometry. A glow radiates, so the offset goes
   and the blur widens; a shadow falls, so it keeps both. */
html.dark .profile-header img {
  box-shadow:
    0 0 0 1px color-mix(in srgb, var(--text) 9%, transparent),
    0 5px 34px color-mix(in srgb, var(--text) 20%, transparent);
}

.intro {
  min-width: 0;
}

.intro h1 {
  margin: 0 0 4px 0;
  font-size: 1.85rem;
}

.intro h1 .given {
  font-weight: 400;
}

.intro h1 .family {
  font-weight: 600;

  /* the hyphen is a break opportunity; never split the surname */
  white-space: nowrap;
}

/* affiliation line, directly under the name */
.tagline {
  margin: 0 0 14px 0;
  color: var(--text-muted);
  font-size: 0.95rem;
}

.intro p {
  margin: 0 0 12px 0;
  line-height: 1.55;
  max-width: 58ch;
}

.intro p:last-child {
  margin-bottom: 0;
}

/* =========================
   SECTION SEPARATORS

   A rule above each section heading, so Research, Selected
   publications and News read as distinct blocks rather than
   one continuous scroll.

   This used to restate the whole heading style, because the
   h1/h2/h3 rules in Layout.astro were scoped to Layout's own
   markup — which contains no headings — and so never reached
   page content. They are wrapped in :global() now and do, so
   only the local spacing survives here.
========================= */

section > h2 {
  /* Only the extra breathing room is local now. Size, weight,
     tracking and the accent tick all come from the global
     heading scale, which reaches page content since the rules
     in Layout were wrapped in :global().

     The border-top is gone with them. It was a section
     separator drawn above the heading, and the tick is a mark
     drawn below it — one heading wearing two dividers, on a
     page whose cards already carry a border and a shadow. The
     larger top margin does the separating instead. */
  margin-top: 4rem;
}

/* A section that ends on its "all …" link needs less air
   before the next rule — the link is already a closing
   gesture, so the full gap read as a gap plus a gap. */
.more + h2 {
  margin-top: 1.75rem;
}

/* =========================
   SELECTED PUBLICATIONS

   Each card carries its own bottom rule as a separator
   between papers, but on the last one that rule sits between
   the section's content and the "All publications" link,
   reading as a divider where there is nothing to divide.

   :global() because .pub belongs to Publication.astro's
   scope — the wrapper is ours, the card is not.
========================= */

.pub-feature-list :global(.pub:last-child) {
  border-bottom: none;
  padding-bottom: 0;
}

/* =========================
   SECTION FOOTER LINKS
========================= */

.more {
  margin: 1.5rem 0 0;
}


/* =========================
   NEWS
========================= */

.news-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.news-item {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 1rem;
  padding: 0.8rem 0;
  border-bottom: 1px solid var(--border);
}

/* the rule separates one item from the next, so the last one
   would leave a stray line hanging above the footer */
.news-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.news-date {
  color: var(--text-muted);
  font-size: 0.9rem;
  white-space: nowrap;
}

.news-content h3 {
  margin: 0 0 0.25rem 0;
  font-size: 1rem;
}

.news-content p {
  margin: 0;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 600px) {
  .profile-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .profile-header img {
    align-self: center;
  }

  .intro p {
    max-width: 100%;
  }

  .news-item {
    grid-template-columns: 1fr;
    gap: 0.25rem;
  }

  .news-date {
    font-weight: 600;
  }
}
</style>
