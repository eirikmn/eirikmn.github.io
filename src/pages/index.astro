---
import Layout from "../layouts/Layout.astro";
/* the home page's own publication card: stacked title /
   authors / venue with the chevron-toggled abstract.
   /publications uses Publication-list.astro, which is the
   denser two-column list style. */
import Publication from "../components/Publication.astro";
import ThemeCards from "../components/ThemeCards.astro";
import { loadBib } from "../lib/bib";
import profile from "../data/cvheader.json";
import newsData from "../data/news.json";

const news = [...newsData].sort(
  (a, b) => new Date(b.date) - new Date(a.date)
);

/* Selected publications are chosen by citation key rather than
   retyped, so titles, venues, DOIs and abstracts stay in step
   with papers.bib and the /publications page. */
const FEATURED = [
  "myrvoll2025bayesian",
  "myrvoll2025synchronization",
  "Sorbye2019"
];

const papers = loadBib("./src/data/papers.bib");

const selected = FEATURED
  .map((key) => papers.find((p) => p.key === key))
  .filter(Boolean);
---

<Layout
  title="Eirik Myrvoll-Nilsen"
  description="Postdoctoral research fellow at UiT The Arctic University of Norway. I work on Bayesian statistics for climate science: long-range dependence, age-depth modeling and early warning signals for tipping points."
>

  <section>

    <!-- PROFILE HEADER -->
    <div class="profile-header">

      <img src="/profile.jpg" alt="Eirik Myrvoll-Nilsen" />

      <div class="intro">
        <h1>Eirik Myrvoll-Nilsen</h1>

        <p class="tagline">
          {profile.title} · {profile.affiliation.institution}
        </p>

        <p>
          I work on Bayesian statistics and latent Gaussian models, mostly
          applied to climate science: long-range dependence, uncertainty
          quantification and synchronization of paleoclimate proxy records,
          and early warning signals ahead of tipping points. More recently
          I have also worked with deep learning methods and data integration.
        </p>

        <p>
          I'm always happy to discuss research ideas, potential collaborations,
          or student projects. <a href="/contact">Contact me</a> if you are
          interested.
        </p>
      </div>

    </div>

    <!-- RESEARCH -->
    <h2>Research</h2>

    <p>
      The main directions I work in — each has a page with the methods,
      figures and papers behind it.
    </p>

    <ThemeCards />

    <p class="more-link">
      <a href="/research">All research themes →</a>
    </p>

    <!-- SELECTED PUBLICATIONS -->
    <h2>Selected publications</h2>

    <div class="pub-feature-list">
      {selected.map((paper) => (
        <Publication
          title={paper.title}
          authors={paper.authors}
          venue={paper.journal || paper.school}
          year={paper.year}
          abstract={paper.abstract}
          doi={paper.doi}
          pdf={paper.pdf}
          url={paper.url}
        />
      ))}
    </div>

    <p class="more-link">
      <a href="/publications">All publications →</a>
    </p>

    <!-- NEWS -->
    {news.length > 0 && (
      <>
        <h2>News</h2>

        <ul class="news-list">
          {news.map((item) => (
            <li class="news-item">
              <div class="news-date">
                {new Date(item.date).toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "short",
                  day: "numeric"
                })}
              </div>

              <div class="news-content">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                {item.url && (
                  <p>
                    <a href={item.url}>Read more →</a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </>
    )}

  </section>

</Layout>

<style>
/* =========================
   PROFILE HEADER
========================= */

.profile-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 40px;
}

.profile-header img {
  width: clamp(150px, 15vw, 180px);
  height: clamp(150px, 15vw, 180px);
  flex-shrink: 0;

  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--border);

  box-shadow: 0 6px 20px color-mix(in srgb, var(--text) 15%, transparent);
}

.intro {
  min-width: 0;
}

.intro h1 {
  margin: 0 0 4px 0;
  font-size: 1.85rem;
}

/* affiliation line, directly under the name */
.tagline {
  margin: 0 0 14px 0;
  color: var(--text-muted);
  font-size: 0.95rem;
}

.intro p {
  margin: 0 0 12px 0;
  line-height: 1.55;
  max-width: 58ch;
}

.intro p:last-child {
  margin-bottom: 0;
}

/* =========================
   SECTION SEPARATORS

   A rule above each section heading, so Research, Selected
   publications and News read as distinct blocks rather than
   one continuous scroll.

   Note this styles h2 locally. The h1/h2/h3 rules in
   Layout.astro are scoped to Layout's own markup, which
   contains no headings, so they never reach page content —
   these headings would otherwise be browser defaults.
========================= */

section > h2 {
  font-size: 1.45rem;
  line-height: 1.25;
  letter-spacing: -0.01em;

  margin: 3.25rem 0 0.5rem;
  padding-top: 2.25rem;

  border-top: 1px solid var(--border);
}

/* =========================
   SELECTED PUBLICATIONS

   Each card carries its own bottom rule as a separator
   between papers, but on the last one that rule sits between
   the section's content and the "All publications" link,
   reading as a divider where there is nothing to divide.

   :global() because .pub belongs to Publication.astro's
   scope — the wrapper is ours, the card is not.
========================= */

.pub-feature-list :global(.pub:last-child) {
  border-bottom: none;
  padding-bottom: 0;
}

/* =========================
   SECTION FOOTER LINKS
========================= */

.more-link {
  margin: 1.25rem 0 0;
  font-size: 1.2rem;
  font-weight: 500;
}

/* =========================
   NEWS
========================= */

.news-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.news-item {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 1rem;
  padding: 0.8rem 0;
  border-bottom: 1px solid var(--border);
}

/* the rule separates one item from the next, so the last one
   would leave a stray line hanging above the footer */
.news-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.news-date {
  color: var(--text-muted);
  font-size: 0.9rem;
  white-space: nowrap;
}

.news-content h3 {
  margin: 0 0 0.25rem 0;
  font-size: 1rem;
}

.news-content p {
  margin: 0;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 600px) {
  .profile-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .profile-header img {
    align-self: center;
  }

  .intro p {
    max-width: 100%;
  }

  .news-item {
    grid-template-columns: 1fr;
    gap: 0.25rem;
  }

  .news-date {
    font-weight: 600;
  }
}
</style>
