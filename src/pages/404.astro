---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="That page does not exist."
  noindex
>

  <div class="page">

<img
  src="/images/404.jpg"
  alt="404"
  class="error-image"
/>

    <h1>404</h1>

    <p class="intro">
      The page you are looking for does not exist (yet).
    </p>

    <p>
      You may have followed a broken link or mistyped the address.
    </p>

    <p class="links">
      <a href="/">← Home</a> ·
      <a href="/research">Research</a> ·
      <a href="/publications">Publications</a>
    </p>

  </div>

</Layout>

<style>
.page {
  max-width: 700px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
  line-height: 1.7;
}

h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

.intro {
  font-size: 1.1rem;
  opacity: 0.8;
}

.links a {
  color: #1a73e8;
  text-decoration: none;
}

.links a:hover {
  text-decoration: underline;
}

.error-image {
  max-width: 350px;
  width: 100%;
  margin: 2rem auto;
  display: block;
  opacity: 0.8;
}
</style>