---
import Layout from "../layouts/Layout.astro";

/* shared styling for every CV entry type */
import "../styles/cv.css";

/* print rules live in their own file so they are only sent
   to browsers on the page that needs them */
import "../styles/cv-print.css";

/* the shared "All publications" pill, also used on the
   homepage and the research subpages */
import "../styles/more-link.css";

import { loadBib } from "../lib/bib";
import { loadBibliography, formatReference } from "../lib/references.js";

/* the reference-list styling shared with the research pages */
import "../styles/citations.css";

import profile from "../data/cvheader.json";

import work from "../data/work.json";
import education from "../data/education.json";
import teaching from "../data/teaching.json";
import development from "../data/development.json";
import supervision from "../data/supervision.json";
import academicService from "../data/academicService.json";
import presentations from "../data/presentations.json";
import software from "../data/software.json";
import skills from "../data/skills.json";

import CVSidebar from "../components/cv/CVSidebar.astro";
import CVSection from "../components/cv/CVSection.astro";

/* CVWorkItem renders both work and education entries */
import CVWorkItem from "../components/cv/CVWorkItem.astro";
import CVTeachingItem from "../components/cv/CVTeachingItem.astro";
import CVDevelopmentItem from "../components/cv/CVDevelopmentItem.astro";
import CVSupervisionItem from "../components/cv/CVSupervisionItem.astro";
import CVAcademicServiceItem from "../components/cv/CVAcademicServiceItem.astro";
import CVSkills from "../components/cv/CVSkills.astro";

import CVHeaderItem from "../components/cv/CVHeaderItem.astro";

const phdSupervision = supervision?.filter((s) => s.degree === "PhD") ?? [];
const mscSupervision = supervision?.filter((s) => s.degree === "MSc") ?? [];

/* =========================
   PUBLICATIONS SUMMARY

   The full list lives on /publications; duplicating it here
   would mean two places to update. Counting from the same
   .bib file the publications page reads means this line can
   never disagree with it, and never goes stale.

   The thesis is excluded from the count and the span — it is
   already in the Education section.
========================= */

const papers = loadBib("./src/data/papers.bib");

const articles = papers.filter(
  (p) => p.entryType !== "phdthesis" && p.type !== "preprint"
);

const years = articles
  .map((p) => Number(p.year))
  .filter((y) => Number.isFinite(y));

const firstYear = years.length ? Math.min(...years) : null;
const lastYear = years.length ? Math.max(...years) : null;

const yearSpan =
  firstYear && lastYear
    ? firstYear === lastYear
      ? `${firstYear}`
      : `${firstYear}–${lastYear}`
    : null;

/* =========================
   THE LIST ITSELF

   /publications is the browsable version — search, abstract
   toggles, PDF and DOI buttons. This is the record: a plain
   bibliographic list, because a CV that says "see elsewhere"
   is not a CV, and the print stylesheet would otherwise
   produce a document with no publications in it at all.

   Rendered with the same formatter the research pages use
   for their reference lists, so author style, page ranges
   and thesis labelling cannot diverge between the two.
========================= */

const AUTHOR_SURNAME = "Myrvoll-Nilsen";

const bibliography = loadBibliography("./src/data/papers.bib");

/* The thesis is not listed here. It appears under Education,
   where its title links to the deposited copy — that is the
   place a reader looks for it, and listing it among the
   journal articles would inflate the count with something
   that was never peer-reviewed.

   Preprints are listed, but in their own group at the end
   and counted separately. A preprint is a status rather than
   a separate publication: when this one is accepted its
   entry in papers.bib gains a journal and loses `type =
   {preprint}`, and it moves up into the year list by itself.
   Nothing is ever listed twice. */
const preprints = bibliography.filter((e) => e.kind === "preprint");

const byYear = new Map();

for (const entry of bibliography
  .filter((e) => e.type !== "phdthesis" && e.kind !== "preprint")
  .sort((a, b) => String(b.year).localeCompare(String(a.year)))) {
  const key = entry.year ?? "Undated";
  if (!byYear.has(key)) byYear.set(key, []);
  byYear.get(key).push(entry);
}

const publicationYears = [...byYear.keys()];

const reference = (entry) =>
  formatReference(entry, { highlight: AUTHOR_SURNAME });

/* The PDF used to be a "here." link inside the note at the
   end of the summary block. It is a button now, so the note
   no longer carries cv_pdf — CVHeaderItem's conditional
   simply stops firing, and nothing there needed changing. */
const cvPdf = profile?.cvPdf ?? "/CV.pdf";

/* =========================
   FUNDING

   Only personal awards — funding won in your own name, not
   the project you were employed on. work.json records both:
   TranOcS and TiPES are host projects, whereas the mobility
   grant was applied for and awarded to you, and that is the
   distinction a committee cares about.

   Flagged in the data with `personalGrant: true` rather than
   matched on a project number here, so adding the next one
   is a data edit and not a code edit.

   Dated by `grantAwarded` — when it was won — not by the
   stay it paid for. That is the convention, and it keeps the
   entry correct independently of the employment dates: this
   grant was awarded in November 2023 for a stay that ran
   April 2024 to April 2025.
========================= */

const grants = work
  .filter((entry) => entry.personalGrant)
  .sort((a, b) =>
    String(b.grantAwarded ?? b.start ?? "").localeCompare(
      String(a.grantAwarded ?? a.start ?? "")
    )
  );

const grantYear = (g) =>
  String(g.grantAwarded ?? g.start ?? "").slice(0, 4) || null;

/* =========================
   LAST UPDATED

   A CV with no date is ambiguous: a reader cannot tell
   whether it is current or three years stale, and that
   matters more here than on any other page.

   Derived rather than typed, by scanning every date in the
   CV data and taking the newest. A hand-written date is a
   promise you have to keep; this one updates itself the
   moment an entry is added, and cannot claim the CV is more
   recent than its newest entry.

   Only ISO YYYY-MM values count. "Spring 2024" and bare
   years are real entries but too coarse to date the page
   with, and an ongoing role has end: null, which would
   otherwise read as no date at all rather than "current".
========================= */

const dated = [
  ...work,
  ...education,
  ...teaching,
  ...supervision,
  ...development,
  /* every bucket in academicService.json, whatever they happen
     to be called. Naming them one at a time meant that adding a
     subsection — as splitting "outreach" into professional
     service and public engagement just did — would silently drop
     its dates out of the "last updated" scan. */
  ...Object.values(academicService ?? {}).flat(),
  /* and every bucket in presentations.json, for the same reason.
     Talks carry a `period` in the same YYYY-MM form, so they are
     eligible to date the page; leaving them out would mean a CV
     whose newest visible entry is a talk still claimed the date
     of something older. */
  ...Object.values(presentations ?? {}).flat()
];

const isoDates = dated
  .flatMap((entry) => [entry.start, entry.end, entry.period])
  .filter((value) => typeof value === "string" && /^\d{4}-\d{2}$/.test(value))
  .sort();

const lastUpdated = isoDates.length ? isoDates[isoDates.length - 1] : null;

const lastUpdatedLabel = lastUpdated
  ? new Date(`${lastUpdated}-01T00:00:00Z`).toLocaleDateString("en-GB", {
      month: "long",
      year: "numeric",
      timeZone: "UTC"
    })
  : null;
---

<Layout
  title="CV"
  description="Curriculum vitae of Eirik Myrvoll-Nilsen: research and work experience, education, teaching, supervision, academic service and skills. Downloadable as PDF."
>

  <div class="cv-grid">

    <!-- CONTENT

         A <div>, not a <main>: Layout.astro already wraps
         every page in <main id="main-content">, and a second
         one nested inside it is invalid — the spec allows one
         per document. It also gave assistive tech two
         competing "main" landmarks, with the skip link
         pointing at the outer one. -->
    <div class="cv-content">

      <!-- SUMMARY -->

      <!-- The h1 below names the page, not the person, so on
           paper — where the print stylesheet strips the site
           header — nothing would identify whose CV this is.
           CVHeaderItem renders position, affiliation, email
           and ORCID but never the name. This line fills that
           gap and is hidden on screen. -->
      <p class="cv-print-name">{profile.name}</p>

      <CVSection id="summary" title="Curriculum Vitae" as="h1">
        <CVHeaderItem />

        <p class="cv-download-row">
          <a class="cv-download" href={cvPdf} download>
            Download CV (PDF)
          </a>

          {lastUpdatedLabel && (
            <span class="cv-updated">
              Last updated <time datetime={lastUpdated}>{lastUpdatedLabel}</time>
            </span>
          )}
        </p>
      </CVSection>

      <!-- WORK -->
      <CVSection id="work" title="Research & Work Experience">
        {work.map((item) => (
          <CVWorkItem {...item} />
        ))}
      </CVSection>

      <!-- EDUCATION -->
      <CVSection id="education" title="Education">
        {education.map((item) => (
          <CVWorkItem {...item} />
        ))}
      </CVSection>

      <!-- PUBLICATIONS -->
      <CVSection id="publications" title="Publications">
        <div class="cv-item">
          {/* Published and unpublished counted separately, so
              the number of journal articles is never inflated
              by work that is not yet through review.

              "Preprint" is the only status tracked. Review
              stage is not verifiable by a reader, does not
              change what they can do with the paper, and ages
              badly — a stale "under review" reads worse than
              no claim. One label means one edit per paper, on
              publication. */}
          <p class="cv-pubs-summary">
            {articles.length} journal articles{yearSpan ? `, ${yearSpan}` : ""}
            {preprints.length === 1
              ? ", and one preprint"
              : preprints.length > 1
                ? `, and ${preprints.length} preprints`
                : ""}.
          </p>

          {publicationYears.map((year) => (
            <>
              <h3 class="cv-pub-year">{year}</h3>
              <ul class="reflist">
                {byYear.get(year).map((entry) => (
                  <li set:html={reference(entry)} />
                ))}
              </ul>
            </>
          ))}

          {preprints.length > 0 && (
            <>
              <h3 class="cv-pub-year">Preprints</h3>
              <ul class="reflist">
                {preprints.map((entry) => (
                  <li set:html={reference(entry)} />
                ))}
              </ul>
            </>
          )}

          <a class="more-link" href="/publications">
            <span>Browse with abstracts and PDFs</span>
          </a>
        </div>
      </CVSection>
      <!-- PRESENTATIONS

           Sits with Publications rather than with Service,
           because a talk is an output: the same work, reaching
           people who will not read the paper. Split by whether
           somebody asked — an invitation is third-party
           evidence that people want to hear from you, and a
           contributed talk is evidence you turned up. Merging
           the two throws that distinction away.

           Each list renders only when it has entries, and the
           section as a whole disappears while they are all
           empty, so nothing shows until presentations.json is
           filled in. -->
      {(presentations.invited?.length ||
        presentations.contributed?.length ||
        presentations.posters?.length) > 0 && (
        <CVSection id="presentations" title="Presentations">

          {(presentations.invited ?? []).length > 0 && (
            <>
              <h3 class="cv-subsection">Invited Talks</h3>
              {presentations.invited.map((item) => (
                <CVAcademicServiceItem {...item} />
              ))}
            </>
          )}

          {(presentations.contributed ?? []).length > 0 && (
            <>
              <h3 class="cv-subsection">Conference Presentations</h3>
              {presentations.contributed.map((item) => (
                <CVAcademicServiceItem {...item} />
              ))}
            </>
          )}

          {(presentations.posters ?? []).length > 0 && (
            <>
              <h3 class="cv-subsection">Posters</h3>
              {presentations.posters.map((item) => (
                <CVAcademicServiceItem {...item} />
              ))}
            </>
          )}

        </CVSection>
      )}


      <!-- FUNDING

           Personal awards only. Kept separate from Research &
           Work Experience above, because "funded by TranOcS"
           describes the post you held, whereas this was won
           in your own name — and a committee reads the two
           very differently.

           The amount renders only when grantAmount is filled,
           so the entry is complete either way. -->
      {grants.length > 0 && (
        <CVSection id="funding" title="Funding">
          {grants.map((g) => (
            <div class="cv-item">
              <div class="cv-item-header">
                <strong>{g.funderprogram}</strong>
                {grantYear(g) && <span class="cv-dates">{grantYear(g)}</span>}
              </div>

              <div class="cv-sub">
                {g.funder}
                {g.projectnumber ? ` · project ${g.projectnumber}` : ""}
                {g.grantAmount ? ` · ${g.grantAmount}` : ""}
              </div>

              <div class="cv-grant-note">
                Research stay at {g.company}, {g.location}.
              </div>
            </div>
          ))}
        </CVSection>
      )}

      <!-- SUPERVISION -->
      <CVSection id="supervision" title="Supervision">

        {phdSupervision.length > 0 && (
          <>
            <h3 class="cv-subsection">PhD Candidates</h3>
            {phdSupervision.map((item) => (
              <CVSupervisionItem {...item} />
            ))}
          </>
        )}

        {mscSupervision.length > 0 && (
          <>
            <h3 class="cv-subsection">Master's Students</h3>
            {mscSupervision.map((item) => (
              <CVSupervisionItem {...item} />
            ))}
          </>
        )}

      </CVSection>

      <!-- TEACHING -->
      <CVSection id="teaching" title="Teaching Experience">
        {teaching.map((item) => (
          <CVTeachingItem {...item} />
        ))}
      </CVSection>

      <!-- SOFTWARE

           Research software is an output, not a skill. The
           Skills section says you can use R; this says you
           wrote and maintain three packages implementing the
           methods from your own papers, which is a different
           and stronger claim.

           Read from software.json, so the CV and /software
           can never disagree about a name or a description. -->
      <CVSection id="software" title="Research Software">
        <div class="cv-item">
          <ul class="cv-software">
            {software.map((pkg) => (
              <li>
                <a
                  class="cv-software-name"
                  href={pkg.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >{pkg.name}</a>
                {pkg.language && <span class="cv-software-lang">{pkg.language}</span>}
                <span class="cv-software-tagline">{pkg.tagline}</span>
              </li>
            ))}
          </ul>

          <a class="more-link" href="/software">
            <span>All software</span>
          </a>
        </div>
      </CVSection>

      {/* SERVICE

          Four subsections rather than three. "Outreach &
          Engagement" had become a catch-all for everything that
          was neither governance nor peer review, and it held
          three different kinds of thing: chairing a conference
          session and sitting on a journal panel are service to
          the FIELD, evidence that peers ask you to run things;
          contributing to a science-centre exhibition is public
          engagement, which funders assess as its own criterion;
          organising a reading group is internal community work.
          Filed together, the conference service read as though
          it were the best that could be found to put there.

          "Organizational Roles" rather than "Leadership": the
          seven entries include deputy and student representative
          posts, which are representation on a governing body
          rather than leadership of one, and the heading was
          claiming a seniority half of them do not have. This one
          claims nothing — membership, representation and office
          all sit under it without strain, and each entry's own
          title says which it was. */}
      <CVSection id="service" title="Academic Service & Outreach">

        {(academicService?.governance ?? []).length > 0 && (
          <>
            <h3 class="cv-subsection">Organizational Roles</h3>
            {academicService.governance.map((item) => (
              <CVAcademicServiceItem {...item} />
            ))}
          </>
        )}

        {(academicService?.review ?? []).length > 0 && (
          <>
            <h3 class="cv-subsection">Peer Review</h3>
            {academicService.review.map((item) => (
              <CVAcademicServiceItem {...item} />
            ))}
          </>
        )}

        {(academicService?.professional ?? []).length > 0 && (
          <>
            <h3 class="cv-subsection">Professional & Community Service</h3>
            {academicService.professional.map((item) => (
              <CVAcademicServiceItem {...item} />
            ))}
          </>
        )}

        {(academicService?.outreach ?? []).length > 0 && (
          <>
            <h3 class="cv-subsection">Outreach & Public Engagement</h3>
            {academicService.outreach.map((item) => (
              <CVAcademicServiceItem {...item} />
            ))}
          </>
        )}

      </CVSection>

      <!-- DEVELOPMENT (NEW SECTION) -->
      <CVSection id="development" title="Professional Development & Certifications">
        {development.map((item) => (
          <CVDevelopmentItem {...item} />
        ))}
      </CVSection>

      <!-- SKILLS -->
      <CVSection id="skills" title="Skills" class="cv-skills-section">
        <CVSkills skills={skills} />
      </CVSection>

    </div>

    <!-- SECTION NAV -->
    <aside class="cv-sidebar">
      <CVSidebar />
    </aside>

  </div>


<!-- =========================
     DISCLOSURE BEHAVIOUR

     One delegated listener for the whole page, rather than a
     copy inside each component that renders a Details button.
     Astro would bundle a component's script once per page
     anyway, but two components carrying the same script is two
     things to keep in step.
========================= -->
<script>
  /* Astro bundles a component's script once per page, however
     many times the component is used, so this is one delegated
     listener rather than one per entry. */

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  /* An open panel is pinned to a pixel max-height so it can be
     animated. Left pinned, it clips its own content the moment
     the text reflows taller — a narrowed window, a late-loading
     font — because the measurement was taken at click time and
     never revisited. Releasing the cap once the opening
     transition has finished lets the panel size itself from
     then on. */
  document.querySelectorAll("[data-panel]").forEach((panel) => {
    panel.addEventListener("transitionend", (e) => {
      if (e.propertyName !== "max-height") return;
      if (panel.classList.contains("open")) panel.style.maxHeight = "none";
    });
  });

  document.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-toggle]");
    if (!btn) return;

    const panel = document.querySelector(
      `[data-panel="${btn.getAttribute("data-toggle")}"]`
    );
    if (!panel) return;

    const isOpen = panel.classList.contains("open");

    if (isOpen) {
      panel.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");

      if (reduceMotion) {
        panel.style.maxHeight = "";
        return;
      }

      /* max-height is "none" by now, and "none" cannot be
         animated to zero. Pin the current height, then clear the
         inline value on the next frame so the stylesheet's
         max-height: 0 becomes the target of a real transition. */
      panel.style.maxHeight = panel.scrollHeight + "px";
      requestAnimationFrame(() => {
        panel.style.maxHeight = "";
      });
    } else {
      panel.classList.add("open");
      btn.setAttribute("aria-expanded", "true");

      /* with motion off there is no transitionend to wait for,
         so release the cap immediately */
      panel.style.maxHeight = reduceMotion
        ? "none"
        : panel.scrollHeight + "px";
    }
  });
</script>

</Layout>

<style>
/* page layout only — entry styling lives in src/styles/cv.css */

/* Nav on the right, matching the research subpages. With it
   on the left the CV content started 228px in from the page
   edge, so its left margin lined up with nothing — not the
   header brand, not the footer, not any other page's h1. */
/* 180px rather than 200px for the nav. The longest label is
   "Publications" at about 85px, so the column was carrying
   100px of slack the content column needed — enough to keep
   the longest teaching row on one line. */
.cv-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180px;
  gap: 2rem;
  align-items: start;
}

.cv-sidebar {
  position: sticky;
  top: 96px;
  height: fit-content;
  min-width: 0;
}

.cv-content {
  display: flex;
  flex-direction: column;
  gap: 1.8rem;
  min-width: 0;
}

/* =========================
   SUBSECTION HEADINGS

   "PhD Candidates", "Peer Review" and so on. These were
   1rem at weight 600 — the same size as the entry titles
   beneath them and a weight lighter, so a heading was
   outranked by its own content and read as body text.

   The fix is a change of register rather than of size.
   Uppercase with letter-spacing reads as structure because
   it is a different kind of text, not a slightly bigger
   version of the same one; making it larger instead would
   put three near-identical bold sizes inside one card.

   Same treatment as .cv-pub-year below and the sidebar's
   label, but at full text colour rather than muted — those
   are running labels, this is a real division.
========================= */

.cv-subsection {
  /* The label sits left, a hairline fills the rest of the
     width. Typography alone was not enough to mark the
     boundary — a rule crossing the card is unmissable, and
     an inline one delimits the group without adding a
     free-standing third kind of divider. */
  display: flex;
  align-items: center;
  gap: 0.7rem;

  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  /* Accent rather than body colour, which also puts some
     blue back on a page that lost all of it when the entry
     spines went. Pulled 30% toward the text colour: plain
     accent is 2.6:1 on the card in light mode, well under
     the 4.5:1 floor for text this size. This lands at
     4.56:1 light and 8.50:1 dark. */
  color: color-mix(in srgb, var(--accent) 70%, var(--text));

  /* 1.75rem above against 0.6rem below, on top of the 1rem
     flex gap either side, so a new group is separated by
     noticeably more than two entries within one. */
  margin: 1.75rem 0 0.6rem;
}

.cv-subsection::after {
  content: "";
  flex: 1;
  height: 1px;
  background: color-mix(in srgb, var(--border-ui) 80%, transparent);
}

/* nothing to separate from at the top of a section */
.cv-subsection:first-child {
  margin-top: 0;
}

/* =========================
   PRINT-ONLY NAME

   Hidden on screen, where the site header and the homepage
   already carry the name. cv-print.css reveals it.
========================= */

.cv-print-name {
  display: none;
}

/* =========================
   CV DOWNLOAD

   "Downloadable as PDF" is in this page's meta description,
   so it is a reason people arrive. It was previously only a
   word in the note at the end of the summary block.
========================= */

.cv-download-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;

  margin: 0.25rem 0 0;
}

.cv-updated {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.cv-download {
  display: inline-block;
  padding: 8px 16px;
  border-radius: 999px;

  background: var(--accent);

  /* fixed rather than var(--bg): the accent is a mid blue in
     both themes, so the label has to stay light or it drops
     below the contrast floor in dark mode */
  color: #ffffff;

  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;

  transition: filter 0.15s ease, transform 0.15s ease;
}

.cv-download:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

/* =========================
   PUBLICATIONS SUMMARY
========================= */

.cv-pubs-summary {
  margin: 0 0 0.5rem;
  color: var(--text);
}

/* Year headings inside the publication list. Smaller and
   lighter than .cv-subsection, which marks a real division
   like "PhD Candidates" — these are just labels on a run of
   entries, and shouting them would compete with the section
   heading above. */
.cv-pub-year {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;

  color: var(--text-muted);
  margin: 1.1rem 0 0.4rem;
}

.cv-pub-year:first-of-type {
  margin-top: 0.6rem;
}

.cv-grant-note {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 0.2rem;
}

/* =========================
   RESEARCH SOFTWARE

   Name, language badge and one line each. The grid keeps the
   name column aligned down the list so the three packages
   read as a set rather than three loose sentences; the
   tagline spans the full width beneath on narrow screens.
========================= */

.cv-software {
  list-style: none;
  margin: 0 0 0.9rem;
  padding: 0;

  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

/* The third track is minmax(0, 1fr) and it matters: grid
   hands leftover space to `auto` tracks, so with only two of
   them both would stretch — inflating the badge to the right
   margin and dragging the name's underline across the empty
   space with it. The flexible third column absorbs the slack
   instead, keeping the first two at their content width. */
.cv-software li {
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr);
  align-items: baseline;
  column-gap: 0.5rem;
}

.cv-software-name {
  /* a grid item stretches to its track by default, and the
     underline would stretch with it */
  justify-self: start;

  font-weight: 600;
  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  font-size: 0.9rem;
  color: var(--text);
  text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--text) 35%, transparent);
}

.cv-software-name:hover {
  color: var(--accent);
  border-bottom-color: var(--accent);
}

/* The language matters here in a way it does not on the
   software page: on a CV "R package" is the unit of output. */
.cv-software-lang {
  justify-self: start;

  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.04em;

  padding: 1px 6px;
  border-radius: 999px;
  border: 1px solid var(--border-ui);
  background: var(--bg);
  color: var(--text-muted);

  white-space: nowrap;
}

.cv-software-tagline {
  font-size: 0.85rem;
  color: var(--text-muted);
  min-width: 0;
}

/* Below this the three columns cannot share a line, so the
   tagline drops to its own row beneath the name and badge.

   The column template is deliberately left alone — dropping
   to `auto auto` is what made the badge stretch to the right
   margin. Keeping the flexible third track means it simply
   sits empty on the first row and soaks up the slack. */
@media (max-width: 560px) {
  .cv-software li {
    row-gap: 0.15rem;
  }

  .cv-software-tagline {
    grid-column: 1 / -1;
  }
}


@media (max-width: 900px) {
  .cv-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  /* nav above the content once it is no longer a column */
  .cv-sidebar {
    position: static;
    order: -1;
  }
}

/* Below this width the sections stop being cards (see
   CVSection) and take over their own separation, so the
   parent's gap would double up with their margins. */
@media (max-width: 560px) {
  .cv-content {
    gap: 0;
  }
}
</style>