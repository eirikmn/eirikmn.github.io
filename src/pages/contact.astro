---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">

  <article class="page">

    <h1>Contact</h1>

    <p class="intro">
      I am happy to discuss research collaborations, statistical methodology,
      and applications of Bayesian inference to complex real-world problems.
    </p>


    <div class="contact-card">

      <h2>Interested in collaborating?</h2>

      <p>
        If you are interested in research collaborations, discussing ideas,
        or learning more about my work, please feel free to get in touch.
      </p>

      <a class="contact-button" href="mailto:eirik.myrvoll-nilsen@uit.no">
        Send me an email →
      </a>

    </div>


    <h2>Email</h2>

    <p>
      <a href="mailto:mailto:eirik.myrvoll-nilsen@uit.no">
        eirik.myrvoll-nilsen@uit.no
      </a>
    </p>


    <h2>Affiliation</h2>

    <p>
      Department of Mathematics and Statistics<br>
      UiT The Arctic University of Norway<br>
      Tromsø, Norway  
    </p>


    <h2>Other links</h2>

    <ul>
      <li>
        <a href="https://scholar.google.com/citations?user=FHoe1FQAAAAJ&hl=no&oi=sra">
          Google Scholar
        </a>
      </li>

      <li>
        <a href="https://github.com/eirikmn">
          GitHub
        </a>
      </li>

      <li>
        <a href="https://orcid.org/0000-0002-1643-5661">
          ORCID
        </a>
      </li>
    </ul>


  </article>


</Layout>


<style>

.page {
  max-width: 750px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
  line-height: 1.7;
  font-size: 1.05rem;
}


h1 {
  margin-bottom: 1rem;
}


.intro {
  font-size: 1.1rem;
  opacity: 0.85;
  margin-bottom: 2rem;
}


h2 {
  margin-top: 2.5rem;
}


/* Collaboration panel */

.contact-card {
  margin: 2rem 0;
  padding: 1.5rem;
  border: 1px solid var(--border);
  border-radius: 12px;

  background: color-mix(
    in srgb,
    var(--bg) 92%,
    var(--accent)
  );
}


.contact-card h2 {
  margin-top: 0;
  border: none;
  padding-bottom: 0;
}


.contact-card p {
  margin-bottom: 1.25rem;
}


/* Email/action link */

.contact-button {
  display: inline-block;

  padding: 0.6rem 1rem;

  border-radius: 8px;
  border: 1px solid var(--border-ui);

  color: var(--text);
  text-decoration: none;

  transition:
    border-color 0.2s ease,
    color 0.2s ease;
}


.contact-button:hover {
  border-color: var(--accent);
  color: var(--accent);
}


ul {
  padding-left: 1.2rem;
}


</style>