---
import Layout from "../layouts/Layout.astro";
import { loadBib } from "../lib/bib";
import Publication from "../components/Publication-list.astro";

const papers = loadBib("./src/data/papers.bib");

// newest first
papers.sort((a, b) => b.year - a.year);

/* Group by year so the list is scannable and the span of the
   work is visible at a glance. The array is already sorted,
   so insertion order gives descending years. */
const byYear = new Map();

for (const paper of papers) {
  const key = paper.year ?? "Undated";
  if (!byYear.has(key)) byYear.set(key, []);
  byYear.get(key).push(paper);
}

const years = [...byYear.keys()];

/* Themes, for the filter chips.

   The labels live here rather than in the .bib because they are display
   strings; the .bib carries only the machine ids. Order is deliberate -
   it follows the research section, not the paper counts.

   Only themes that actually occur are offered, so the row can never
   advertise a filter that would return nothing. */
const THEME_LABELS = {
  longmemory: "Long-range dependence",
  agemodeling: "Age-depth modelling",
  earlywarning: "Early warning signals"
};

const themeCounts = new Map();
for (const p of papers) {
  for (const t of p.themes ?? []) {
    themeCounts.set(t, (themeCounts.get(t) ?? 0) + 1);
  }
}

const themes = Object.keys(THEME_LABELS)
  .filter((t) => themeCounts.has(t))
  .map((t) => ({ id: t, label: THEME_LABELS[t], count: themeCounts.get(t) }));

/* Orientation line under the heading. Both numbers are already to hand,
   and "15 publications, 2018-2026" tells a visitor the scale and the span
   before they read a single entry. */
const yearsNumeric = papers.map((p) => Number(p.year)).filter(Number.isFinite);
const spanFrom = Math.min(...yearsNumeric);
const spanTo = Math.max(...yearsNumeric);

/* -------------------------------------------------------
   STRUCTURED DATA

   An ItemList of ScholarlyArticle, so reference managers and
   search engines can read the publications without scraping
   the rendered markup. Zotero's connector picks this up and
   offers to save every item on the page at once, which is the
   thing a second export format would only partly solve.

   Deliberately NOT citation_title / citation_author meta tags:
   those describe ONE article per page, and Google Scholar
   reads them that way. Fifteen sets on a listing page is not
   a supported arrangement. Proper Scholar indexing would need
   a page per publication, which is a much larger change.

   Layout.astro already emits a Person schema for the site
   owner; this is a separate block on this page only.
------------------------------------------------------- */

/* BibTeX gives "Surname, Given and Surname, Given". Split into
   the two name parts so consumers get structured people rather
   than one opaque string. "and others" is a truncation marker,
   not a person - drop it. */
function toPerson(entry) {
  const name = entry.trim();
  if (!name || name.toLowerCase() === "others") return null;

  const [family, given] = name.includes(",")
    ? name.split(",").map((s) => s.trim())
    : [name.split(" ").pop(), name.split(" ").slice(0, -1).join(" ")];

  return {
    "@type": "Person",
    name: given ? `${given} ${family}` : family,
    ...(given ? { givenName: given } : {}),
    familyName: family
  };
}

const SCHEMA_TYPE = {
  phdthesis: "Thesis",
  preprint: "ScholarlyArticle",
  comment: "ScholarlyArticle"
};

const publicationsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Publications by Eirik Myrvoll-Nilsen",
  numberOfItems: papers.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: papers.map((p, i) => {
    const authors = (p.authors ?? "")
      .split(/\s+and\s+/i)
      .map(toPerson)
      .filter(Boolean);

    const doiUrl = p.doi
      ? (p.doi.startsWith("http") ? p.doi : `https://doi.org/${p.doi}`)
      : null;

    const item = {
      "@type": SCHEMA_TYPE[(p.type ?? p.entryType ?? "").toLowerCase()] ?? "ScholarlyArticle",
      name: p.title,
      author: authors,
      datePublished: String(p.year),
      /* abstracts are left out on purpose: they are 19.6 of the 33 KB this
         block would otherwise weigh, they are already in the page body in
         the collapsible panels, and any consumer that wants one can fetch
         it from the DOI. Everything a reference manager actually needs to
         build an entry - title, authors, year, DOI, journal, pages - is
         here. */
      ...(doiUrl ? { url: doiUrl, sameAs: doiUrl } : {}),
      ...(p.journal ? { isPartOf: { "@type": "Periodical", name: p.journal } } : {}),
      ...(p.volume ? { volumeNumber: String(p.volume) } : {}),
      ...(p.pages ? { pagination: String(p.pages) } : {}),
      /* the hosted copy, so a reader arriving from a search engine can
         reach the full text rather than only the landing page */
      ...(p.pdf ? { encoding: { "@type": "MediaObject", contentUrl: p.pdf, encodingFormat: "application/pdf" } } : {})
    };

    return { "@type": "ListItem", position: i + 1, item };
  })
};
---

<Layout
  title="Publications"
  description="Journal articles and PhD thesis by Eirik Myrvoll-Nilsen on Bayesian statistics, long-memory processes, paleoclimate age-depth modeling and early warning signals."
>

  <script type="application/ld+json" set:html={JSON.stringify(publicationsSchema)} />

  <section>

    <h1>Publications</h1>

    <p>
      Journal articles and my PhD thesis, newest first.
      <span class="pub-count">
        {papers.length} publications, {spanFrom}&ndash;{spanTo}.
      </span>
    </p>

    <!-- THEME FILTERS -->
    <div class="pub-themes" role="group" aria-label="Filter by research theme">
      <button type="button" class="theme-chip is-active" data-theme="all" aria-pressed="true">
        All
      </button>
      {themes.map((t) => (
        <button type="button" class="theme-chip" data-theme={t.id} aria-pressed="false">
          {t.label} <span class="theme-count">{t.count}</span>
        </button>
      ))}
    </div>

    <!-- SEARCH -->
    <div class="pub-search">

      <label class="visually-hidden" for="pub-search-input">
        Search publications
      </label>

      <input
        id="pub-search-input"
        type="search"
        autocomplete="off"
        placeholder="Search by title, author, journal or year…"
      />

      <button id="pub-search-clear" type="button" aria-label="Clear search" hidden>
        ×
      </button>

    </div>

    <div class="pub-bulk">
      <button id="pub-copy-all" type="button" class="bulk-btn">
        Copy BibTeX for all shown
      </button>
      <a href="/publications.bib" class="bulk-btn" download>
        Download .bib
      </a>
    </div>

    <p id="pub-search-status" class="pub-search-status" role="status" hidden></p>

    <div id="pub-list">
      {years.map((year) => (
        <section class="pub-year-group" data-year={year}>

          <h2 class="pub-year">{year}</h2>

          {byYear.get(year).map((paper) => (
            <Publication
              key={paper.key}
              title={paper.title}
              themes={paper.themes}
              bibtex={paper.bibtex}
              type={paper.type}
              authors={paper.authors}
              venue={paper.journal || paper.school}
              year={paper.year}
              abstract={paper.abstract}
              doi={paper.doi}
              pdf={paper.pdf}
              url={paper.url}
              volume={paper.volume}
              number={paper.number}
              pages={paper.pages}
            />
          ))}

        </section>
      ))}
    </div>

  </section>

</Layout>

<script>
  /* Same folding as the haystack baked into each entry at build time -
     imported rather than reimplemented, because if the two ever disagreed
     the search would miss silently. */
  import { fold } from "../lib/fold.js";

  const input = document.getElementById("pub-search-input");
  const clear = document.getElementById("pub-search-clear");
  const status = document.getElementById("pub-search-status");
  const papers = Array.from(document.querySelectorAll("#pub-list .pub"));
  const groups = Array.from(document.querySelectorAll(".pub-year-group"));

  const chips = Array.from(document.querySelectorAll(".theme-chip"));
  let activeTheme = "all";

  function apply() {
    /* every term must appear somewhere in the entry, so
       "myrvoll 2023" narrows rather than widens */
    const terms = fold(input.value).split(/\s+/).filter(Boolean);

    let shown = 0;

    papers.forEach((paper) => {
      const haystack = paper.dataset.search || "";
      /* the two filters compose: a paper must satisfy the search AND the
         theme, so switching theme with a query typed does not silently
         discard the query */
      const themeOk =
        activeTheme === "all" ||
        (paper.dataset.themes || "").split(" ").includes(activeTheme);
      const match = themeOk && terms.every((t) => haystack.includes(t));

      paper.hidden = !match;
      if (match) shown++;
    });

    /* drop a year heading once every paper under it is filtered
       out, so the results don't show empty years */
    groups.forEach((group) => {
      const anyVisible = Array.from(group.querySelectorAll(".pub"))
        .some((p) => !p.hidden);
      group.hidden = !anyVisible;
    });

    clear.hidden = terms.length === 0;

    /* the status line now has to cover a theme filter with no query, so it
       keys off "is anything filtering" rather than off the query alone */
    const filtering = terms.length > 0 || activeTheme !== "all";

    if (!filtering) {
      status.hidden = true;
    } else {
      status.hidden = false;
      status.textContent =
        shown === 0
          ? "No publications match."
          : `${shown} of ${papers.length} publications`;
    }
  }

  /* ---- copy the BibTeX of everything currently shown ----

     Reads the hidden [data-bib] block each entry already carries for its
     own Cite button, so there is no second copy of the records to keep in
     step. Because it walks only the visible entries, it follows whatever
     the theme chips and the search box have narrowed to.

     Feedback goes to the existing status line rather than into the button
     label: rewriting the label would resize the button, which is the
     problem the per-entry Cite button had. */
  const copyAll = document.getElementById("pub-copy-all");

  function shownBibtex() {
    return papers
      .filter((p) => !p.hidden)
      .map((p) => p.querySelector("[data-bib]")?.textContent?.trim())
      .filter(Boolean)
      .join("\n\n");
  }

  copyAll.addEventListener("click", () => {
    const text = shownBibtex();
    const n = text ? text.split(/\n\n/).length : 0;

    const say = (msg) => {
      status.hidden = false;
      status.textContent = msg;
      /* let the next filter change take the line back over */
      setTimeout(apply, 2500);
    };

    if (!n) return say("Nothing to copy.");

    navigator.clipboard?.writeText(text).then(
      () => say(`Copied BibTeX for ${n} publication${n === 1 ? "" : "s"}.`),
      () => say("Copy failed. Use the .bib download instead.")
    ) ?? say("Copy failed. Use the .bib download instead.");
  });

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activeTheme = chip.dataset.theme;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle("is-active", on);
        c.setAttribute("aria-pressed", String(on));
      });
      apply();
    });
  });

  input.addEventListener("input", apply);

  input.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      input.value = "";
      apply();
    }
  });

  clear.addEventListener("click", () => {
    input.value = "";
    input.focus();
    apply();
  });

  /* re-apply on load in case the browser restored a value */
  apply();
</script>

<style>
.pub-count {
  color: var(--text-muted);
}

/* ---- theme filters ---- */

.pub-themes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 1.25rem 0 0;
}

.theme-chip {
  font: inherit;
  font-size: 0.82rem;
  line-height: 1;

  padding: 7px 11px;

  color: var(--text-muted);
  background: transparent;
  border: 1px solid var(--border-ui);
  border-radius: 999px;

  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.theme-chip:hover {
  color: var(--text);
  border-color: var(--accent);
}

/* The selected chip is carried by colour AND weight, not colour alone:
   aria-pressed tells a screen reader, but a sighted reader who cannot
   separate the two blues needs a second cue. */
.theme-chip.is-active {
  color: var(--accent);
  font-weight: 600;
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 10%, transparent);
}

.theme-count {
  opacity: 0.6;
  font-variant-numeric: tabular-nums;
}

.pub-search {
  position: relative;
  margin: 0.75rem 0 0.75rem;
}

.pub-search input {
  width: 100%;
  box-sizing: border-box;

  padding: 8px 34px 8px 12px;

  font: inherit;
  font-size: 0.9rem;

  color: var(--text);
  background: transparent;

  border: 1px solid var(--border-ui);
  border-radius: 8px;

  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.pub-search input::placeholder {
  color: var(--text);
  opacity: 0.5;
}

.pub-search input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
}

/* hide the native WebKit clear affordance: we have our own */
.pub-search input::-webkit-search-cancel-button {
  -webkit-appearance: none;
  appearance: none;
}

#pub-search-clear {
  position: absolute;
  top: 50%;
  right: 8px;
  transform: translateY(-50%);

  width: 22px;
  height: 22px;
  padding: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 1rem;
  line-height: 1;

  color: var(--text);
  background: transparent;
  border: 1px solid transparent;
  border-radius: 50%;

  cursor: pointer;
  opacity: 0.6;
}

#pub-search-clear:hover {
  opacity: 1;
  border-color: var(--accent);
  color: var(--accent);
}

/* `display: flex` above outranks the `hidden` attribute, so
   without this the clear button showed even with the search
   box empty. */
#pub-search-clear[hidden] {
  display: none;
}

.pub-bulk {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0 0 0.6rem;
}

.bulk-btn {
  font: inherit;
  font-size: 0.78rem;
  line-height: 1;

  padding: 7px 11px;

  color: var(--text-muted);
  background: transparent;
  border: 1px solid var(--border-ui);
  border-radius: 8px;

  text-decoration: none;
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease;
}

.bulk-btn:hover {
  color: var(--accent);
  border-color: var(--accent);
}

/* the global content-link rule adds a hairline under bare <a> inside
   .container; this is a button, so keep it off */
.pub-bulk a.bulk-btn {
  border-bottom: 1px solid var(--border-ui);
}

.pub-bulk a.bulk-btn:hover {
  border-bottom-color: var(--accent);
}

.pub-search-status {
  margin: 0 0 1rem;
  font-size: 0.82rem;
  opacity: 0.7;
}

/* ---- year grouping ---- */

.pub-year-group {
  margin-bottom: 2rem;
}

/* quieter than a document heading: this is a divider in a
   list, not a section title, so no border and no top margin
   competing with the global h2 */
/* The heading rules in Layout are global, so this is a year
   label wearing an h2's clothes. It opts out of the border it
   never wanted and, now, of the accent tick — a mark under each
   of "2026", "2025", "2024" down the page would read as a dozen
   section headings rather than one list broken into years. */
.pub-year::after {
  display: none;
}

.pub-year {
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: 0.04em;

  color: var(--text-muted);

  margin: 0 0 0.75rem;
  padding: 0;
  border: none;
}

.pub-year-group[hidden] {
  display: none;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
</style>